---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Aethra 03',
	description = 'Dokumentasi dan buku tahunan angkatan Aethra 03: 64 rekan Masadagri Batch III, Kementerian Dalam Negeri.',
} = Astro.props;

const pageTitle = title === 'Aethra 03' ? title : `${title} · Aethra 03`;
const path = Astro.url.pathname;

const nav = [
	{ href: '/', num: '01', label: 'Rumah Aethra' },
	{ href: '/rasi', num: '02', label: 'Rasi Aethra' },
	{ href: '/rasa', num: '03', label: 'Jejak Rasa' },
	{ href: '/cipta', num: '04', label: 'Galeri Cipta' },
];
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fbf9f4" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#konten">Lewati ke konten</a>

		<!-- Pita atas: Kepala Berita / Arsip Resmi -->
		<div class="masthead-top">
			<div class="container masthead-inner">
				<span class="masthead-left">
					<span class="bullet" aria-hidden="true">■</span>
					ARSIP DOKUMENTASI ANGKATAN · MASADAGRI BATCH III
				</span>
				<span class="masthead-right">
					KEMENTERIAN DALAM NEGERI RI · VOL. 03 · 2024
				</span>
			</div>
		</div>

		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Aethra 03, kembali ke beranda">
					<span class="brand-script">Aethra</span>
					<span class="brand-num">03</span>
					<span class="brand-tag">BUKU TAHUNAN</span>
				</a>
				<nav aria-label="Navigasi Utama">
					<ul class="nav-list">
						{
							nav.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={path === item.href ? 'page' : undefined}
										class="nav-link"
									>
										<span class="nav-num">{item.num}</span>
										<span class="nav-label">{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="konten">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-col-brand">
					<span class="footer-title">Aethra 03</span>
					<p class="footer-motto">Cipta · Rasa · Karsa</p>
					<p class="footer-note">
						Arsip kenangan dan dokumentasi dibuat secara independen oleh peserta Aethra 03
						untuk merawat memori kebersamaan selama masa bakti di Kementerian Dalam Negeri.
					</p>
				</div>
				<div class="footer-col-meta">
					<div class="meta-box">
						<span class="meta-label">STATUS DOKUMEN</span>
						<span class="meta-val">Arsip Terbuka Angkatan</span>
					</div>
					<div class="meta-box">
						<span class="meta-label">TOTAL REKAN</span>
						<span class="meta-val">64 Peserta Masadagri</span>
					</div>
					<div class="meta-box">
						<span class="meta-label">LOKASI ARSIP</span>
						<span class="meta-val">Jakarta Pusat, Indonesia</span>
					</div>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>© 2024 Aethra 03. Bukan publikasi resmi Kementerian Dalam Negeri Republik Indonesia.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	main {
		flex: 1;
	}

	/* Pita Kepala Surat / Masthead */
	.masthead-top {
		background: var(--navy-deep);
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		padding-block: 0.4rem;
		border-bottom: 1px solid var(--navy-primary);
	}

	.masthead-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.bullet {
		color: var(--gold-badge);
		margin-right: 0.35rem;
		font-size: 0.6rem;
	}

	/* Navigasi Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(251, 249, 244, 0.94);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--paper-border-strong);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.75rem;
		flex-wrap: wrap;
	}

	.brand {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		text-decoration: none;
		color: var(--navy-deep);
		line-height: 1;
	}

	.brand-script {
		font-family: var(--font-script);
		font-size: 2.2rem;
		color: var(--navy-deep);
		line-height: 0.9;
	}

	.brand-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.4rem;
		font-weight: 600;
		color: var(--gold-accent);
	}

	.brand-tag {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		padding: 0.15rem 0.4rem;
		border: 1px solid var(--paper-border-strong);
		border-radius: var(--radius-sm);
		background: var(--paper-warm);
		color: var(--ink-muted);
		align-self: center;
	}

	.nav-list {
		display: flex;
		gap: 0.35rem 1.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--ink-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.35rem 0.2rem;
		border-bottom: 2px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.nav-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink-faint);
	}

	.nav-link:hover {
		color: var(--navy-deep);
		border-bottom-color: var(--paper-border-strong);
	}

	.nav-link[aria-current='page'] {
		color: var(--navy-deep);
		font-weight: 600;
		border-bottom-color: var(--navy-primary);
	}

	.nav-link[aria-current='page'] .nav-num {
		color: var(--gold-accent);
	}

	/* Footer / Kolofon Arsip */
	.site-footer {
		margin-top: 6rem;
		background: var(--paper-warm);
		border-top: 2px solid var(--paper-border-strong);
		padding-top: 3.5rem;
		padding-bottom: 2.5rem;
		color: var(--ink-muted);
		font-size: 0.88rem;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--paper-border);
	}

	.footer-title {
		font-family: var(--font-script);
		font-size: 2.6rem;
		color: var(--navy-deep);
		display: block;
		line-height: 1;
		margin-bottom: 0.25rem;
	}

	.footer-motto {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: 1.25rem;
		color: var(--gold-accent);
		margin: 0 0 0.8rem;
	}

	.footer-note {
		max-width: 34rem;
		line-height: 1.6;
		color: var(--ink-muted);
		margin: 0;
	}

	.footer-col-meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 1.5rem;
		align-content: start;
	}

	.meta-box {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		border-left: 2px solid var(--paper-border-strong);
		padding-left: 0.8rem;
	}

	.meta-label {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.meta-val {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--navy-deep);
	}

	.footer-bottom {
		padding-top: 1.8rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 768px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.masthead-right {
			display: none;
		}
	}
</style>
