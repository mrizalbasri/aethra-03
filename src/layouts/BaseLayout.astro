---
import '../styles/global.css';
import Moon from '../components/Moon.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Aethra 03',
	description = 'Dokumentasi dan buku tahunan angkatan Aethra 03: 64 rekan Masadagri Batch III, Kementerian Dalam Negeri.',
} = Astro.props;

const pageTitle = title === 'Aethra 03' ? title : `${title} · Aethra 03`;
const path = Astro.url.pathname;

const nav = [
	{ href: '/', num: '01', label: 'Rumah Aethra' },
	{ href: '/rasi', num: '02', label: 'Rasi Aethra' },
	{ href: '/rasa', num: '03', label: 'Jejak Rasa' },
	{ href: '/cipta', num: '04', label: 'Galeri Cipta' },
];
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#konten">Lewati ke konten</a>

		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="Aethra 03, kembali ke beranda">
					<Moon class="brand-emblem" />
					<span class="brand-script">Aethra</span>
					<span class="brand-num">03</span>
					<span class="brand-divider" aria-hidden="true"></span>
					<span class="brand-sub">Masadagri III</span>
				</a>
				<nav aria-label="Navigasi Utama">
					<ul class="nav-list">
						{
							nav.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={path === item.href ? 'page' : undefined}
										class="nav-link"
									>
										<sup class="nav-num">{item.num}</sup>
										<span class="nav-label">{item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="konten">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-col-brand">
					<div class="footer-brand-row">
						<Moon class="footer-emblem" />
						<span class="footer-title">Aethra 03</span>
					</div>
					<p class="footer-motto">Cipta · Rasa · Karsa</p>
					<p class="footer-note">
						Buku tahunan dan dokumentasi kebersamaan peserta Masadagri Batch III, dibuat oleh
						peserta untuk merawat kenangan selama di Kementerian Dalam Negeri.
					</p>
				</div>

				<div class="footer-col-nav">
					<span class="footer-heading">Daftar Isi</span>
					<ul class="footer-links">
						{
							nav.map((item) => (
								<li>
									<a href={item.href}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="footer-col-meta">
					<span class="footer-heading">Ringkasan Angkatan</span>
					<dl class="meta-list">
						<div class="meta-row">
							<dt>Keluarga Besar</dt>
							<dd>64 Peserta</dd>
						</div>
						<div class="meta-row">
							<dt>Angkatan</dt>
							<dd>Masadagri Batch III</dd>
						</div>
						<div class="meta-row">
							<dt>Inisiatif</dt>
							<dd>Rekan Angkatan Aethra 03</dd>
						</div>
					</dl>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>
					© Aethra 03 · Dibuat oleh peserta untuk peserta. Bukan publikasi resmi Kementerian
					Dalam Negeri RI.
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	main {
		flex: 1;
	}

	/* Navigasi Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 0.9rem;
		flex-wrap: wrap;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		color: var(--navy);
		line-height: 1;
	}

	:global(.brand-emblem) {
		width: 1.5rem;
		height: 1.5rem;
		color: var(--gold);
	}

	.brand-script {
		font-family: var(--font-script);
		font-size: 2.05rem;
		color: var(--navy);
		line-height: 0.9;
		padding-top: 0.15rem;
	}

	.brand-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.35rem;
		font-weight: 600;
		color: var(--gold);
	}

	.brand-divider {
		width: 1px;
		height: 1rem;
		background: var(--border-strong);
		margin-inline: 0.35rem;
	}

	.brand-sub {
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.nav-list {
		display: flex;
		gap: 0.35rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}

	.nav-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
		color: var(--ink-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.35rem 0.1rem;
		border-bottom: 2px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.nav-num {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		color: var(--ink-faint);
		line-height: 1;
	}

	.nav-link:hover {
		color: var(--navy);
		border-bottom-color: var(--border-strong);
	}

	.nav-link[aria-current='page'] {
		color: var(--navy);
		font-weight: 600;
		border-bottom-color: var(--navy);
	}

	.nav-link[aria-current='page'] .nav-num {
		color: var(--gold);
	}

	/* Footer Editorial */
	.site-footer {
		margin-top: 5rem;
		background: var(--bg);
		border-top: 1px solid var(--border);
		padding-top: 4rem;
		padding-bottom: 2.5rem;
		color: var(--ink-muted);
		font-size: 0.9rem;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1.1fr);
		gap: 3rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.footer-brand-row {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.45rem;
	}

	:global(.footer-emblem) {
		width: 1.75rem;
		height: 1.75rem;
		color: var(--gold);
	}

	.footer-title {
		font-family: var(--font-script);
		font-size: 2.5rem;
		color: var(--navy);
		line-height: 1;
	}

	.footer-motto {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: 1.2rem;
		color: var(--gold);
		margin: 0 0 0.85rem;
	}

	.footer-note {
		max-width: 30rem;
		line-height: 1.65;
		color: var(--ink-muted);
		margin: 0;
	}

	.footer-heading {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 1rem;
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.footer-links a {
		text-decoration: none;
		color: var(--navy);
		font-weight: 500;
		font-size: 0.92rem;
	}

	.footer-links a:hover {
		color: var(--gold);
	}

	.meta-list {
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
		font-size: 0.86rem;
	}

	.meta-row dt {
		color: var(--ink-faint);
	}

	.meta-row dd {
		margin: 0;
		font-weight: 600;
		color: var(--navy);
		text-align: right;
	}

	.footer-bottom {
		padding-top: 1.75rem;
		font-size: 0.78rem;
		color: var(--ink-faint);
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 860px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}

	@media (max-width: 640px) {
		.brand-divider,
		.brand-sub {
			display: none;
		}
	}
</style>
