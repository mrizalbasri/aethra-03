---
import Moon from './Moon.astro';

interface Props {
	judul: string;
	catatan: string;
	kode?: string;
}
const { judul, catatan, kode = 'Bagian Angkatan · Aethra 03' } = Astro.props;
---

<section class="ph container">
	<div class="ph-card">
		<div class="ph-emblem-wrap" aria-hidden="true">
			<Moon class="ph-moon" />
		</div>
		<p class="eyebrow ph-eyebrow">{kode}</p>
		<h1 class="ph-title">{judul}</h1>
		<p class="ph-desc">{catatan}</p>
		<div class="ph-actions">
			<a class="btn btn-primary" href="/">← Kembali ke Rumah Aethra</a>
		</div>
	</div>
</section>

<style>
	.ph {
		min-height: 62vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: 4rem;
	}

	.ph-card {
		background: #ffffff;
		border: 1px solid var(--border);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.8rem, 5vw, 3.5rem);
		border-radius: var(--radius-lg);
		box-shadow:
			0 24px 48px -20px rgba(11, 22, 40, 0.08),
			0 2px 6px rgba(11, 22, 40, 0.03);
		max-width: 40rem;
		width: 100%;
		text-align: center;
	}

	.ph-emblem-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-pill);
		background: var(--gold-soft);
		border: 1px solid rgba(158, 115, 31, 0.22);
		margin-bottom: 1.5rem;
	}

	:global(.ph-moon) {
		width: 1.45rem;
		height: 1.45rem;
		color: var(--gold);
	}

	.ph-eyebrow {
		justify-content: center;
		margin-bottom: 0.75rem;
	}

	.ph-title {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: clamp(2.4rem, 6vw, 3.8rem);
		color: var(--navy);
		margin: 0 0 1rem;
		line-height: 1.08;
	}

	.ph-desc {
		font-size: 1.05rem;
		color: var(--ink-muted);
		max-width: 30rem;
		margin-inline: auto;
		margin-bottom: 2.25rem;
		line-height: 1.65;
	}

	.ph-actions {
		display: flex;
		justify-content: center;
	}
</style>
