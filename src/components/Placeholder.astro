---
interface Props {
	judul: string;
	catatan: string;
	kode?: string;
}
const { judul, catatan, kode = 'DOC-REV-03' } = Astro.props;
---

<section class="ph container">
	<div class="ph-card">
		<div class="ph-stamp">
			<span class="stamp-code">{kode}</span>
			<span class="stamp-status">LEMBAR ARSIP DALAM PROSES</span>
		</div>
		<h1 class="ph-title">{judul}</h1>
		<p class="ph-desc">{catatan}</p>
		<div class="ph-actions">
			<a class="btn btn-primary" href="/">← Kembali ke Rumah Aethra</a>
		</div>
	</div>
</section>

<style>
	.ph {
		min-height: 65vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: 4rem;
	}

	.ph-card {
		background: #ffffff;
		border: 1px solid var(--paper-border-strong);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.8rem, 5vw, 3.5rem);
		border-radius: var(--radius);
		box-shadow:
			0 20px 40px -15px rgba(10, 20, 36, 0.08),
			0 2px 6px rgba(10, 20, 36, 0.04);
		max-width: 42rem;
		width: 100%;
		text-align: center;
		position: relative;
	}

	.ph-stamp {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		border: 1px dashed var(--gold-accent);
		padding: 0.4rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--gold-light);
		margin-bottom: 2rem;
	}

	.stamp-code {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.15em;
		font-weight: 700;
		color: var(--gold-accent);
	}

	.stamp-status {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: var(--navy-deep);
		font-weight: 600;
	}

	.ph-title {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(2.4rem, 6vw, 4rem);
		color: var(--navy-deep);
		margin: 0 0 1rem;
		line-height: 1.1;
	}

	.ph-desc {
		font-size: 1.1rem;
		color: var(--ink-muted);
		max-width: 32rem;
		margin-inline: auto;
		margin-bottom: 2.5rem;
		line-height: 1.6;
	}

	.ph-actions {
		display: flex;
		justify-content: center;
	}
</style>
