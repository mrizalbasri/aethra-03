---
import Moon from './Moon.astro';

interface Props {
	caption: string;
	subcaption?: string;
	tag?: string;
	rotation?: number;
	variant?: 'crest' | 'editorial' | 'warm';
	imageSrc?: string;
	imageAlt?: string;
	showTape?: boolean;
	aspectRatio?: string;
	class?: string;
}

const {
	caption,
	subcaption = 'Masadagri Batch III',
	tag = 'EDISI 03',
	rotation = 0,
	variant = 'crest',
	imageSrc,
	imageAlt,
	showTape = true,
	aspectRatio = '4/3',
	class: className = '',
} = Astro.props;
---

<figure
	class:list={['polaroid', className]}
	style={`--rotation: ${rotation}deg; --aspect: ${aspectRatio};`}
>
	{showTape && <div class="tape" aria-hidden="true" />}
	<div class="photo-frame">
		{
			imageSrc ? (
				<img class="photo-img" src={imageSrc} alt={imageAlt ?? caption} loading="lazy" />
			) : variant === 'crest' ? (
				<div class="plate plate-crest">
					<div class="plate-crest-inner">
						<Moon class="plate-crest-moon" />
						<span class="plate-crest-script">Aethra 03</span>
						<span class="plate-crest-meta">64 REKAN · SATU MASA</span>
					</div>
				</div>
			) : variant === 'editorial' ? (
				<div class="plate plate-editorial">
					<svg
						class="plate-arch-svg"
						viewBox="0 0 240 160"
						fill="none"
						aria-hidden="true"
						focusable="false"
					>
						<line x1="24" y1="128" x2="216" y2="128" stroke="#cbd5e1" stroke-width="1" />
						<path d="M56 128 V70 A34 34 0 0 1 124 70 V128" stroke="#0b1628" stroke-width="1.3" />
						<path
							d="M116 128 V70 A34 34 0 0 1 184 70 V128"
							stroke="#334e73"
							stroke-width="1.1"
							stroke-dasharray="3 3"
						/>
						<circle cx="150" cy="40" r="6" fill="#cfa144" />
					</svg>
					<span class="plate-editorial-label">CATATAN MASA BAKTI</span>
					<span class="plate-editorial-sub">JAKARTA PUSAT</span>
				</div>
			) : (
				<div class="plate plate-warm">
					<span class="plate-warm-star" aria-hidden="true">✦</span>
					<p class="plate-warm-quote">
						“Dari berbagai daerah, bertemu dalam satu cerita.”
					</p>
				</div>
			)
		}
		<span class="plate-tag">{tag}</span>
	</div>
	<figcaption class="polaroid-caption">
		<span class="caption-title">{caption}</span>
		{subcaption && <span class="caption-sub">{subcaption}</span>}
	</figcaption>
</figure>

<style>
	.polaroid {
		position: relative;
		margin: 0;
		padding: 0.85rem 0.85rem 1.25rem;
		background: #ffffff;
		border: 1px solid var(--border, #e2e8f0);
		border-radius: 4px;
		box-shadow:
			0 22px 48px -16px rgba(11, 22, 40, 0.14),
			0 4px 12px rgba(11, 22, 40, 0.04);
		transform: rotate(var(--rotation));
		transition:
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.35s ease;
		display: inline-flex;
		flex-direction: column;
		width: 100%;
		max-width: 21rem;
	}

	.polaroid:hover {
		transform: rotate(0deg) scale(1.02);
		box-shadow:
			0 28px 56px -16px rgba(11, 22, 40, 0.2),
			0 8px 18px rgba(11, 22, 40, 0.06);
		z-index: 10;
	}

	.tape {
		position: absolute;
		top: -0.75rem;
		left: 50%;
		transform: translateX(-50%) rotate(-1.5deg);
		width: 5rem;
		height: 1.4rem;
		background: rgba(241, 245, 249, 0.82);
		border: 1px solid rgba(203, 213, 225, 0.7);
		backdrop-filter: blur(4px);
		box-shadow: 0 1px 3px rgba(11, 22, 40, 0.06);
		z-index: 2;
		pointer-events: none;
	}

	.photo-frame {
		position: relative;
		border: 1px solid var(--border, #e2e8f0);
		overflow: hidden;
		aspect-ratio: var(--aspect);
		background: var(--surface, #f8fafc);
	}

	.photo-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.plate {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1.15rem;
		position: relative;
	}

	/* Varian 1: Crest (Midnight Navy & Gold) */
	.plate-crest {
		background: radial-gradient(circle at 50% 35%, #162844 0%, #0b1628 100%);
		padding: 0.75rem;
	}

	.plate-crest-inner {
		width: 100%;
		height: 100%;
		border: 1px solid rgba(207, 161, 68, 0.35);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 1rem;
		text-align: center;
	}

	:global(.plate-crest-moon) {
		width: 2.3rem !important;
		height: 2.3rem !important;
		color: var(--gold-bright, #cfa144) !important;
	}

	.plate-crest-script {
		font-family: var(--font-script, cursive);
		font-size: 1.9rem;
		color: #ffffff;
		line-height: 1;
	}

	.plate-crest-meta {
		font-family: var(--font-mono, monospace);
		font-size: 0.56rem;
		letter-spacing: 0.2em;
		color: rgba(245, 217, 142, 0.85);
	}

	/* Varian 2: Editorial Arsitektural */
	.plate-editorial {
		background: var(--surface-alt, #f1f5f9);
		justify-content: space-between;
		padding: 1rem;
		text-align: center;
	}

	.plate-arch-svg {
		width: 85%;
		max-height: 62%;
	}

	.plate-editorial-label {
		font-family: var(--font-mono, monospace);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		color: var(--navy, #0b1628);
		font-weight: 600;
	}

	.plate-editorial-sub {
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		color: var(--ink-faint, #64748b);
	}

	/* Varian 3: Warm Champagne Typographic Plate */
	.plate-warm {
		background: #fcf9f2;
		border-inline: 1px solid rgba(207, 161, 68, 0.15);
		text-align: center;
		gap: 0.6rem;
	}

	.plate-warm-star {
		font-size: 1.15rem;
		color: var(--gold, #9e731f);
		line-height: 1;
	}

	.plate-warm-quote {
		font-family: var(--font-serif, serif);
		font-style: italic;
		font-weight: 500;
		font-size: 1.12rem;
		line-height: 1.35;
		color: var(--navy, #0b1628);
		margin: 0;
		max-width: 14rem;
	}

	.plate-tag {
		position: absolute;
		bottom: 0.5rem;
		right: 0.5rem;
		font-family: var(--font-mono, monospace);
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--navy, #0b1628);
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid var(--border, #e2e8f0);
		padding: 0.12rem 0.4rem;
		border-radius: 2px;
	}

	.polaroid-caption {
		display: flex;
		flex-direction: column;
		gap: 0.18rem;
		padding-top: 0.75rem;
		padding-inline: 0.15rem;
	}

	.caption-title {
		font-family: var(--font-serif, serif);
		font-weight: 600;
		font-size: 1.15rem;
		line-height: 1.2;
		color: var(--navy, #0b1628);
	}

	.caption-sub {
		font-family: var(--font-body, sans-serif);
		font-size: 0.74rem;
		letter-spacing: 0.02em;
		color: var(--ink-faint, #64748b);
	}
</style>
