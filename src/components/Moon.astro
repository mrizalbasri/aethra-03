---
// Lambang bulan sabit linework (acuan bordir Aethra). Dekoratif.
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={`moon-icon ${className}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
	<defs>
		<mask id="moon-cut">
			<rect width="200" height="200" fill="white"></rect>
			<circle cx="128" cy="86" r="74" fill="black"></circle>
		</mask>
	</defs>
	<circle cx="96" cy="104" r="84" fill="currentColor" mask="url(#moon-cut)"></circle>
</svg>

<style>
	.moon-icon {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--gold-accent, #9a6e1a);
	}
</style>
