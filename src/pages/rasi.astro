---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberModal from '../components/MemberModal.astro';
import type { MemberItem } from '../scripts/memberModal';
import { formatMetaAnggota, getInisial } from '../utils/yearbook';

const TOTAL = 64;
const peserta = (await getCollection('peserta', ({ data }) => data.setuju)).sort((a, b) =>
	a.data.nama.localeCompare(b.data.nama, 'id'),
);

const fotoModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/peserta/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
	{ eager: true },
);

interface SlotCard extends MemberItem {
	index: number;
	imageMeta?: ImageMetadata;
}

const slots: SlotCard[] = await Promise.all(
	Array.from({ length: TOTAL }, async (_, i) => {
		const p = peserta[i];
		const no = String(i + 1).padStart(2, '0');
		if (!p) {
			return {
				index: i,
				no,
				inisial: '',
				nama: `Kursi #${no}`,
				meta: 'Menunggu profil teman Aethra 03',
				tercatat: false,
			};
		}

		let imageMeta: ImageMetadata | undefined;
		let fotoUrl: string | undefined;
		if (p.data.foto) {
			const match = Object.entries(fotoModules).find(([path]) => path.endsWith(`/${p.data.foto}`));
			if (match) {
				imageMeta = match[1].default;
				const optimized = await getImage({ src: imageMeta, width: 480, height: 480 });
				fotoUrl = optimized.src;
			}
		}

		const meta = formatMetaAnggota(p.data.divisi, p.data.daerah);
		return {
			index: i,
			no,
			inisial: getInisial(p.data.nama),
			nama: p.data.nama,
			meta,
			divisi: p.data.divisi,
			daerah: p.data.daerah,
			kalimat: p.data.kalimat,
			pesan: p.data.pesan,
			fotoUrl,
			imageMeta,
			tercatat: true,
		};
	}),
);

const filledSlots = slots.filter((s) => s.tercatat);
const initialRandom = filledSlots[0];

const divisiList = Array.from(
	new Set(peserta.map((p) => p.data.divisi).filter((d): d is string => Boolean(d))),
).sort((a, b) => a.localeCompare(b, 'id'));

const modalItems: MemberItem[] = slots.map(({ imageMeta: _m, index: _i, ...rest }) => rest);
const serializedMembers = JSON.stringify(modalItems).replace(/</g, '\\u003c');
---

<BaseLayout
	title="Rasi Aethra"
	description="Direktori 64 teman seangkatan Aethra 03 Masadagri: profil, kota asal, divisi, dan pesan kenangan."
>
	<section class="page-head container">
		<div class="head-grid">
			<div class="head-copy">
				<p class="eyebrow">01 — Rasi Aethra</p>
				<h1>Wajah &amp; Cerita <em>Teman Seangkatan</em></h1>
				<p class="head-desc">
					Enam puluh empat teman dari berbagai penjuru Indonesia yang pernah berbagi cerita di Batch
					3. Cari nama, pilih penempatan, atau sapa teman secara acak.
				</p>
				<div class="head-stats">
					<div class="stat-pill">
						<strong>{peserta.length}</strong>
						<span>Profil Masuk</span>
					</div>
					<div class="stat-pill">
						<strong>{TOTAL}</strong>
						<span>Kursi Angkatan</span>
					</div>
				</div>
			</div>

			{
				initialRandom && (
					<aside class="spotlight-widget" aria-label="Sapa teman secara acak">
						<div class="sw-head">
							<span class="sw-label">✦ Kenalan Acak</span>
							<button type="button" class="chip" data-random-next data-cursor="Putar">
								Putar Lagi ↻
							</button>
						</div>

						<div class="sw-profile">
							<div class="sw-avatar">
								<img
									class="sw-img"
									data-rand-img
									src={initialRandom.fotoUrl ?? ''}
									alt={initialRandom.nama}
									hidden={!initialRandom.fotoUrl}
								/>
								<span class="sw-initials" data-rand-initials hidden={Boolean(initialRandom.fotoUrl)}>
									{initialRandom.inisial}
								</span>
							</div>
							<div class="sw-identity">
								<strong class="sw-name" data-rand-name>
									{initialRandom.nama}
								</strong>
								<span class="sw-meta" data-rand-meta>
									{initialRandom.meta}
								</span>
							</div>
						</div>

						<p class="sw-kalimat" data-rand-kalimat>
							{initialRandom.kalimat ? `“${initialRandom.kalimat}”` : 'Teman seperjuangan Aethra 03.'}
						</p>

						<div class="sw-foot">
							<span class="sw-no" data-rand-no>
								Kursi #{initialRandom.no}
							</span>
							<button type="button" class="btn btn-primary btn-sm" data-random-open>
								Baca Pesan Lengkap →
							</button>
						</div>
					</aside>
				)
			}
		</div>
	</section>

	<section class="controls-wrap container" aria-label="Filter dan pencarian teman">
		<div class="controls-bar">
			<div class="search-wrap">
				<label class="sr-only" for="rasi-search">Cari nama, kota asal, atau divisi</label>
				<input
					id="rasi-search"
					type="search"
					class="search-field"
					placeholder="Cari nama, kota asal, atau divisi..."
					data-rasi-search
				/>
			</div>

			<div class="filter-group">
				<button type="button" class="chip is-active" data-view-mode="cards">
					Kartu Profil ({peserta.length})
				</button>
				<button type="button" class="chip" data-view-mode="map">
					Peta 64 Kursi
				</button>
				<button type="button" class="chip" data-rasi-shuffle data-cursor="Acak">
					Acak Urutan ↻
				</button>
			</div>
		</div>

		{
			divisiList.length > 0 && (
				<div class="divisi-bar" role="group" aria-label="Filter berdasarkan divisi">
					<button type="button" class="chip is-active" data-divisi="all">
						Semua Divisi
					</button>
					{divisiList.map((div) => (
						<button type="button" class="chip" data-divisi={div}>
							{div}
						</button>
					))}
				</div>
			)
		}

		<p class="result-count" data-rasi-count>
			Menampilkan {filledSlots.length} profil teman yang sudah masuk
		</p>
	</section>

	<!-- Tampilan 1: Kartu Profil Teman -->
	<section class="directory container" data-rasi-cards-view>
		<div class="rasi-grid" data-rasi-grid>
			{
				filledSlots.map((slot) => (
					<button
						type="button"
						class="member-card"
						data-rasi-card
						data-index={slot.index}
						data-divisi={slot.divisi ?? ''}
						data-search={`${slot.nama} ${slot.divisi ?? ''} ${slot.daerah ?? ''} ${slot.kalimat ?? ''} #${slot.no}`.toLowerCase()}
						data-tilt
						data-cursor="Profil"
					>
						<div class="card-top">
							<span class="card-no">#{slot.no}</span>
							{slot.divisi && <span class="card-divisi">{slot.divisi}</span>}
						</div>

						<div class="card-avatar">
							{slot.imageMeta ? (
								<Image
									src={slot.imageMeta}
									width={320}
									height={320}
									alt={slot.nama}
									class="card-photo"
								/>
							) : (
								<span class="card-initials">{slot.inisial}</span>
							)}
						</div>

						<div class="card-info">
							<h2 class="card-name">{slot.nama}</h2>
							<p class="card-daerah">{slot.daerah ?? 'Masadagri Batch 3'}</p>
							{slot.kalimat && <p class="card-kalimat">“{slot.kalimat}”</p>}
						</div>

						<span class="card-action">Lihat Profil →</span>
					</button>
				))
			}
		</div>

		<div class="empty-state" data-rasi-empty hidden>
			<p>Belum ada profil yang cocok dengan pencarian atau filter divisi ini.</p>
			<button type="button" class="btn btn-secondary" data-rasi-reset>Reset Filter</button>
		</div>

		{
			TOTAL - filledSlots.length > 0 && (
				<div class="invite-banner" data-rasi-invite>
					<div class="invite-copy">
						<strong>{TOTAL - filledSlots.length} kursi lainnya disiapkan untuk teman-teman Aethra 03</strong>
						<span>
							Profil dan foto teman yang baru masuk akan otomatis tampil di daftar ini. Kamu juga
							bisa melihat susunan lengkap 64 kursi kapan saja.
						</span>
					</div>
					<button type="button" class="btn btn-secondary btn-sm" data-switch-map>
						Buka Peta 64 Kursi →
					</button>
				</div>
			)
		}
	</section>

	<!-- Tampilan 2: Peta Konstelasi 64 Kursi -->
	<section class="map-view container" data-rasi-map-view hidden aria-label="Peta 64 kursi angkatan">
		<div class="map-frame">
			<div class="map-head">
				<div>
					<h2>Peta Konstelasi 64 Kursi</h2>
					<p>
						Kotak biru menandai teman yang profilnya sudah masuk; kotak bernomor lainnya menunggu
						giliran menyusul. Klik petak mana saja untuk melihat kartu.
					</p>
				</div>
				<div class="map-legend">
					<span><i class="leg-dot is-navy" aria-hidden="true"></i> Sudah Masuk ({filledSlots.length})</span>
					<span><i class="leg-dot" aria-hidden="true"></i> Menyusul ({TOTAL - filledSlots.length})</span>
				</div>
			</div>

			<div class="mosaic-grid" data-rasi-map-grid>
				{
					slots.map((slot) => (
						<button
							type="button"
							class:list={['mosaic-tile', { 'is-filled': slot.tercatat }]}
							data-map-tile
							data-index={slot.index}
							data-filled={slot.tercatat ? '1' : '0'}
							data-divisi={slot.divisi ?? ''}
							data-search={`${slot.nama} ${slot.divisi ?? ''} ${slot.daerah ?? ''} #${slot.no}`.toLowerCase()}
							data-cursor={slot.tercatat ? 'Profil' : 'Kursi'}
							aria-label={`Kursi ${slot.no}: ${slot.nama}`}
						>
							<span class="tile-no">{slot.no}</span>
							{slot.tercatat ? (
								<>
									<span class="tile-initials">{slot.inisial}</span>
									<span class="tile-dot" aria-hidden="true" />
								</>
							) : (
								<span class="tile-star" aria-hidden="true">
									✦
								</span>
							)}
						</button>
					))
				}
			</div>
		</div>
	</section>

	<MemberModal />
	<script type="application/json" id="rasi-members-data" set:html={serializedMembers} />
</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { Flip } from 'gsap/Flip';
	import { initMotion } from '../scripts/motion';
	import { initTiltCards } from '../scripts/interactions';
	import { setupMemberModal, type MemberItem } from '../scripts/memberModal';

	gsap.registerPlugin(Flip);

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const dataEl = document.getElementById('rasi-members-data');
	const members: MemberItem[] = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];
	const modal = setupMemberModal(members);

	// 1. Widget Sapa Teman Acak
	const filledIndices = members
		.map((m, idx) => (m.tercatat ? idx : -1))
		.filter((idx) => idx >= 0);
	let currentRandomPos = 0;

	const randNextBtn = document.querySelector<HTMLButtonElement>('[data-random-next]');
	const randOpenBtn = document.querySelector<HTMLButtonElement>('[data-random-open]');
	const randImg = document.querySelector<HTMLImageElement>('[data-rand-img]');
	const randInitials = document.querySelector<HTMLElement>('[data-rand-initials]');
	const randName = document.querySelector<HTMLElement>('[data-rand-name]');
	const randMeta = document.querySelector<HTMLElement>('[data-rand-meta]');
	const randKalimat = document.querySelector<HTMLElement>('[data-rand-kalimat]');
	const randNo = document.querySelector<HTMLElement>('[data-rand-no]');

	const renderRandom = (memberIdx: number) => {
		const item = members[memberIdx];
		if (!item) return;

		if (randImg && randInitials) {
			if (item.fotoUrl) {
				randImg.src = item.fotoUrl;
				randImg.alt = item.nama;
				randImg.hidden = false;
				randInitials.hidden = true;
			} else {
				randImg.hidden = true;
				randInitials.hidden = false;
				randInitials.textContent = item.inisial;
			}
		}
		if (randName) randName.textContent = item.nama;
		if (randMeta) randMeta.textContent = item.meta;
		if (randKalimat) {
			randKalimat.textContent = item.kalimat
				? `“${item.kalimat}”`
				: 'Teman seperjuangan Aethra 03.';
		}
		if (randNo) randNo.textContent = `Kursi #${item.no}`;
	};

	randNextBtn?.addEventListener('click', () => {
		if (filledIndices.length <= 1) return;
		let nextPos = currentRandomPos;
		while (nextPos === currentRandomPos) {
			nextPos = Math.floor(Math.random() * filledIndices.length);
		}
		currentRandomPos = nextPos;
		renderRandom(filledIndices[currentRandomPos]!);
	});

	randOpenBtn?.addEventListener('click', () => {
		const idx = filledIndices[currentRandomPos] ?? 0;
		modal.openAt(idx);
	});

	// 2. Filter, Pencarian, Shuffle & Pengalih Tampilan
	const cardsView = document.querySelector<HTMLElement>('[data-rasi-cards-view]');
	const mapView = document.querySelector<HTMLElement>('[data-rasi-map-view]');
	const grid = document.querySelector<HTMLElement>('[data-rasi-grid]');
	const mapGrid = document.querySelector<HTMLElement>('[data-rasi-map-grid]');
	const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-rasi-card]'));
	const mapTiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-map-tile]'));

	const searchInput = document.querySelector<HTMLInputElement>('[data-rasi-search]');
	const viewModeBtns = document.querySelectorAll<HTMLButtonElement>('[data-view-mode]');
	const switchMapBtn = document.querySelector<HTMLButtonElement>('[data-switch-map]');
	const divisiBtns = document.querySelectorAll<HTMLButtonElement>('[data-divisi]');
	const shuffleBtn = document.querySelector<HTMLButtonElement>('[data-rasi-shuffle]');
	const resetBtn = document.querySelector<HTMLButtonElement>('[data-rasi-reset]');
	const countEl = document.querySelector<HTMLElement>('[data-rasi-count]');
	const emptyEl = document.querySelector<HTMLElement>('[data-rasi-empty]');

	let viewMode: 'cards' | 'map' = 'cards';
	let activeDivisi = 'all';
	let query = '';

	const setViewMode = (mode: 'cards' | 'map') => {
		viewMode = mode;
		viewModeBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.viewMode === mode));
		if (cardsView) cardsView.hidden = mode !== 'cards';
		if (mapView) mapView.hidden = mode !== 'map';
		applyFilters();
	};

	const applyFilters = () => {
		const q = query.trim().toLowerCase();
		let shownCards = 0;

		cards.forEach((card) => {
			const divisi = card.dataset.divisi ?? '';
			const haystack = card.dataset.search ?? '';
			const divisiPass = activeDivisi === 'all' || divisi === activeDivisi;
			const searchPass = !q || haystack.includes(q);
			const visible = divisiPass && searchPass;

			card.hidden = !visible;
			if (visible) shownCards += 1;
		});

		let matchedMap = 0;
		const hasFilter = activeDivisi !== 'all' || Boolean(q);
		mapTiles.forEach((tile) => {
			const divisi = tile.dataset.divisi ?? '';
			const haystack = tile.dataset.search ?? '';
			const divisiPass = activeDivisi === 'all' || divisi === activeDivisi;
			const searchPass = !q || haystack.includes(q);
			const visible = divisiPass && searchPass;

			tile.classList.toggle('is-dimmed', hasFilter && !visible);
			tile.classList.toggle('is-match', hasFilter && visible);
			if (visible) matchedMap += 1;
		});

		if (countEl) {
			if (viewMode === 'cards') {
				countEl.textContent = `Menampilkan ${shownCards} dari ${cards.length} profil teman yang sudah masuk`;
			} else {
				countEl.textContent = hasFilter
					? `Menyorot ${matchedMap} kursi yang cocok di peta 64`
					: `Menampilkan seluruh peta 64 kursi Aethra 03`;
			}
		}

		if (emptyEl) {
			emptyEl.hidden = viewMode !== 'cards' || shownCards > 0;
		}
	};

	cards.forEach((card) => {
		card.addEventListener('click', () => {
			modal.openAt(Number(card.dataset.index ?? 0));
		});
	});

	mapTiles.forEach((tile) => {
		tile.addEventListener('click', () => {
			modal.openAt(Number(tile.dataset.index ?? 0));
		});
	});

	viewModeBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			setViewMode(btn.dataset.viewMode === 'map' ? 'map' : 'cards');
		});
	});

	switchMapBtn?.addEventListener('click', () => {
		setViewMode('map');
		mapView?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
	});

	searchInput?.addEventListener('input', () => {
		query = searchInput.value;
		applyFilters();
	});

	divisiBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			activeDivisi = btn.dataset.divisi ?? 'all';
			divisiBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
			applyFilters();
		});
	});

	shuffleBtn?.addEventListener('click', () => {
		const targetGrid = viewMode === 'cards' ? grid : mapGrid;
		if (!targetGrid) return;
		const current = Array.from(targetGrid.children);
		const state = !reducedMotion ? Flip.getState(current) : null;

		for (let i = current.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[current[i], current[j]] = [current[j]!, current[i]!];
		}
		current.forEach((el) => targetGrid.appendChild(el));

		if (state && !reducedMotion) {
			Flip.from(state, {
				duration: 0.48,
				ease: 'power2.inOut',
				stagger: 0.01,
			});
		}
	});

	resetBtn?.addEventListener('click', () => {
		query = '';
		activeDivisi = 'all';
		if (searchInput) searchInput.value = '';
		divisiBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.divisi === 'all'));
		applyFilters();
	});

	initTiltCards('[data-tilt]');

	initMotion((gsapInstance) => {
		gsapInstance.from('.member-card', {
			y: 22,
			opacity: 0,
			duration: 0.5,
			ease: 'power2.out',
			stagger: 0.06,
		});
	});
</script>

<style>
	.page-head {
		padding-top: clamp(3rem, 6vw, 4.5rem);
		padding-bottom: 2.75rem;
		border-bottom: 1px solid var(--border);
	}

	.head-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
		gap: 2.5rem;
		align-items: center;
	}

	.head-copy {
		max-width: 38rem;
	}

	.head-desc {
		font-size: 1.02rem;
		color: var(--ink-muted);
		margin: 0 0 1.5rem;
	}

	.head-stats {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.stat-pill {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.55rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
	}

	.stat-pill strong {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		color: var(--navy);
		line-height: 1;
	}

	.stat-pill span {
		font-size: 0.76rem;
		font-weight: 500;
		color: var(--ink-faint);
	}

	/* Widget Kenalan Acak */
	.spotlight-widget {
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.4rem 1.5rem;
		box-shadow: 0 20px 44px -22px rgba(11, 22, 40, 0.1);
		display: grid;
		gap: 1rem;
	}

	.sw-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}

	.sw-label {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.sw-profile {
		display: flex;
		align-items: center;
		gap: 0.95rem;
	}

	.sw-avatar {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 12px;
		background: var(--navy);
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		overflow: hidden;
	}

	.sw-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.sw-initials {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 600;
	}

	.sw-identity {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.sw-name {
		font-family: var(--font-serif);
		font-size: 1.45rem;
		line-height: 1.15;
		color: var(--navy);
	}

	.sw-meta {
		font-size: 0.82rem;
		color: var(--ink-faint);
	}

	.sw-kalimat {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		line-height: 1.38;
		color: var(--navy-soft);
		margin: 0;
	}

	.sw-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
