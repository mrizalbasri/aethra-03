---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInisial } from '../utils/yearbook';

const kenangan = await getCollection('kenangan');
const kegiatanList = await getCollection('kegiatan');
const kegiatanMap = new Map(kegiatanList.map((k) => [k.id, k.data.judul]));

const items = kenangan.map((k, idx) => ({
	id: k.id,
	index: idx,
	no: String(idx + 1).padStart(2, '0'),
	nama: k.data.nama,
	inisial: getInisial(k.data.nama),
	divisi: k.data.divisi ?? '',
	kegiatanJudul: k.data.kegiatan ? (kegiatanMap.get(k.data.kegiatan) ?? k.data.kegiatan) : '',
	teks: k.data.teks,
	variant: idx % 5 === 2 ? 'navy' : idx % 3 === 1 ? 'warm' : 'white',
}));

const tagSet = new Set<string>();
items.forEach((item) => {
	if (item.divisi) tagSet.add(item.divisi);
	if (item.kegiatanJudul) tagSet.add(item.kegiatanJudul);
});
const filterTags = Array.from(tagSet).sort((a, b) => a.localeCompare(b, 'id'));

const prompts = [
	'Momen apa yang paling bikin satu ruangan tertawa waktu lagi sibuk-sibuknya?',
	'Hal paling tidak terduga yang kamu temui di minggu pertama masuk unit kerja?',
	'Satu kalimat terima kasih buat teman semeja atau kawan seangkatan?',
	'Kebiasaan kopi sore atau makan siang bareng mana yang bakal paling dirindukan?',
	'Kalau masa magang ini dibuatkan judul film, judul apa yang paling cocok?',
];

const serializedMemories = JSON.stringify(items).replace(/</g, '\\u003c');
const serializedPrompts = JSON.stringify(prompts).replace(/</g, '\\u003c');
---

<BaseLayout
	title="Jejak Rasa"
	description="Dinding cerita, tawa, dan pesan hangat antarteman angkatan Aethra 03 Masadagri."
>
	<section class="page-head container">
		<div class="head-grid">
			<div class="head-copy">
				<p class="eyebrow">02 — Jejak Rasa</p>
				<h1>Cerita Kecil yang <em>Bikin Kangen</em></h1>
				<p class="head-desc">
					Dari kejadian lucu di minggu pertama sampai pesan tulus buat teman semeja. Semua cerita
					dikumpulkan di sini supaya tidak hilang tertumpuk chat.
				</p>
				<div class="head-stats">
					<div class="stat-pill">
						<strong>{items.length}</strong>
						<span>Cerita Masuk</span>
					</div>
					<div class="stat-pill">
						<strong data-fav-total>0</strong>
						<span>Tersimpan ★</span>
					</div>
				</div>
			</div>

			<aside class="prompt-card" aria-label="Pemantik cerita angkatan">
				<div class="prompt-head">
					<span class="prompt-counter" data-prompt-counter>
						PERTANYAAN 01 / {String(prompts.length).padStart(2, '0')}
					</span>
					<span class="prompt-tag">Pemantik Obrolan</span>
				</div>
				<p class="prompt-text" data-prompt-text>{prompts[0]}</p>
				<div class="prompt-actions">
					<button type="button" class="chip" data-prompt-next data-cursor="Ganti">
						Pertanyaan Lain ↻
					</button>
					<button type="button" class="chip" data-prompt-copy>Salin Pertanyaan</button>
				</div>
			</aside>
		</div>
	</section>

	<section class="controls-wrap container" aria-label="Filter dan pencarian cerita">
		<div class="controls-bar">
			<div class="search-wrap">
				<label class="sr-only" for="rasa-search">Cari isi cerita, nama teman, atau momen</label>
				<input
					id="rasa-search"
					type="search"
					class="search-field"
					placeholder="Cari isi cerita, nama teman, atau momen..."
					data-rasa-search
				/>
			</div>
			<div class="filter-group">
				<button type="button" class="chip is-active" data-rasa-tag="all">Semua Cerita</button>
				<button type="button" class="chip" data-rasa-fav-filter>
					Tersimpan ★ (<span data-fav-filter-count>0</span>)
				</button>
				{
					filterTags.map((tag) => (
						<button type="button" class="chip" data-rasa-tag={tag}>
							{tag}
						</button>
					))
				}
				<button type="button" class="chip" data-rasa-shuffle data-cursor="Acak">
					Acak Kartu ↻
				</button>
			</div>
		</div>
	</section>

	<section class="wall container">
		<div class="rasa-grid" data-rasa-grid>
			{
				items.map((item) => (
					<article
						class="story-card"
						data-variant={item.variant}
						data-rasa-card
						data-id={item.id}
						data-index={item.index}
						data-tags={`${item.divisi}|${item.kegiatanJudul}`}
						data-search={`${item.nama} ${item.divisi} ${item.kegiatanJudul} ${item.teks}`.toLowerCase()}
						data-tilt
					>
						<div class="story-top">
							<span class="story-mark" aria-hidden="true">
								“
							</span>
							<div class="story-top-actions">
								{item.kegiatanJudul && <span class="story-pill">{item.kegiatanJudul}</span>}
								<button
									type="button"
									class="fav-btn"
									data-fav-id={item.id}
									aria-pressed="false"
									aria-label={`Simpan cerita dari ${item.nama}`}
									title="Simpan ke favorit"
								>
									☆
								</button>
							</div>
						</div>

						<button
							type="button"
							class="story-open-area"
							data-open-story={item.index}
							data-cursor="Baca"
						>
							<p class="story-text">{item.teks}</p>

							<div class="story-foot">
								<div class="story-author">
									<span class="author-badge">{item.inisial}</span>
									<div class="author-meta">
										<strong>{item.nama}</strong>
										{item.divisi && <span>{item.divisi}</span>}
									</div>
								</div>
								<span class="story-read">Baca penuh →</span>
							</div>
						</button>
					</article>
				))
			}
		</div>

		<div class="empty-state" data-rasa-empty hidden>
			<p>Belum ada cerita yang cocok dengan filter atau pencarian ini.</p>
			<button type="button" class="btn btn-secondary" data-rasa-reset>Reset Filter</button>
		</div>

		<aside class="curator-note">
			<p>
				Punya cerita seru atau pesan yang ingin dititipkan buat teman Aethra 03? Kirimkan lewat
				tautan pengumpulan cerita angkatan atau hubungi teman pengurus supaya ikut dipajang di
				halaman ini.
			</p>
		</aside>
	</section>

	<!-- Reader Dialog -->
	<dialog class="aethra-dialog" data-rasa-dialog aria-labelledby="rd-nama">
		<div class="dialog-panel">
			<div class="rd-head">
				<span class="rd-badge" data-rd-kegiatan>Jejak Rasa</span>
				<button type="button" class="rd-close" data-rd-close aria-label="Tutup cerita">✕</button>
			</div>

			<blockquote class="rd-quote">
				<p data-rd-teks></p>
			</blockquote>

			<div class="rd-author">
				<span class="author-badge" data-rd-inisial>A3</span>
				<div>
					<h3 id="rd-nama" class="rd-name" data-rd-nama></h3>
					<p class="rd-divisi" data-rd-divisi></p>
				</div>
			</div>

			<div class="rd-foot">
				<button type="button" class="chip" data-rd-prev>← Sebelumnya</button>
				<span class="rd-counter" data-rd-counter>01 / 01</span>
				<button type="button" class="chip" data-rd-next>Berikutnya →</button>
			</div>
		</div>
	</dialog>

	<script type="application/json" id="rasa-memories-data" set:html={serializedMemories} />
	<script type="application/json" id="rasa-prompts-data" set:html={serializedPrompts} />
</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { Flip } from 'gsap/Flip';
	import { initMotion } from '../scripts/motion';
	import { initTiltCards } from '../scripts/interactions';
	import { wrapIndex } from '../utils/yearbook';

	gsap.registerPlugin(Flip);

	interface MemoryItem {
		id: string;
		index: number;
		no: string;
		nama: string;
		inisial: string;
		divisi: string;
		kegiatanJudul: string;
		teks: string;
	}

	const FAV_KEY = 'aethra-rasa-favs';
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const memEl = document.getElementById('rasa-memories-data');
	const promptEl = document.getElementById('rasa-prompts-data');
	const memories: MemoryItem[] = memEl?.textContent ? JSON.parse(memEl.textContent) : [];
	const prompts: string[] = promptEl?.textContent ? JSON.parse(promptEl.textContent) : [];

	// 1. Kartu Pemantik Obrolan & Salin Pertanyaan
	const promptCounterEl = document.querySelector<HTMLElement>('[data-prompt-counter]');
	const promptTextEl = document.querySelector<HTMLElement>('[data-prompt-text]');
	const promptNextBtn = document.querySelector<HTMLButtonElement>('[data-prompt-next]');
	const promptCopyBtn = document.querySelector<HTMLButtonElement>('[data-prompt-copy]');
	let promptIdx = 0;

	const updatePromptCounter = () => {
		if (!promptCounterEl) return;
		const cur = String(promptIdx + 1).padStart(2, '0');
		const tot = String(prompts.length).padStart(2, '0');
		promptCounterEl.textContent = `PERTANYAAN ${cur} / ${tot}`;
	};

	promptNextBtn?.addEventListener('click', () => {
		if (!promptTextEl || prompts.length === 0) return;
		promptIdx = (promptIdx + 1) % prompts.length;
		const nextText = prompts[promptIdx] ?? '';
		updatePromptCounter();

		if (reducedMotion) {
			promptTextEl.textContent = nextText;
			return;
		}
		gsap.to(promptTextEl, {
			opacity: 0,
			y: -4,
			duration: 0.16,
			onComplete: () => {
				promptTextEl.textContent = nextText;
				gsap.fromTo(promptTextEl, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.24 });
			},
		});
	});

	let copyTimer: number | undefined;
	promptCopyBtn?.addEventListener('click', async () => {
		const text = prompts[promptIdx] ?? '';
		if (!text) return;
		try {
			await navigator.clipboard?.writeText(text);
			promptCopyBtn.textContent = 'Tersalin ✓';
			window.clearTimeout(copyTimer);
			copyTimer = window.setTimeout(() => {
				promptCopyBtn.textContent = 'Salin Pertanyaan';
			}, 1600);
		} catch {
			// Abaikan jika izin clipboard dibatasi browser
		}
	});

	// 2. Reader Modal
	const dialog = document.querySelector<HTMLDialogElement>('[data-rasa-dialog]');
	const rdKegiatan = dialog?.querySelector<HTMLElement>('[data-rd-kegiatan]');
	const rdTeks = dialog?.querySelector<HTMLElement>('[data-rd-teks]');
	const rdInisial = dialog?.querySelector<HTMLElement>('[data-rd-inisial]');
	const rdNama = dialog?.querySelector<HTMLElement>('[data-rd-nama]');
	const rdDivisi = dialog?.querySelector<HTMLElement>('[data-rd-divisi]');
	const rdCounter = dialog?.querySelector<HTMLElement>('[data-rd-counter]');
	const rdClose = dialog?.querySelector<HTMLButtonElement>('[data-rd-close]');
	const rdPrev = dialog?.querySelector<HTMLButtonElement>('[data-rd-prev]');
	const rdNext = dialog?.querySelector<HTMLButtonElement>('[data-rd-next]');

	let currentMem = 0;

	const renderMemory = (index: number) => {
		if (!memories.length) return;
		currentMem = wrapIndex(index, memories.length);
		const item = memories[currentMem];
		if (!item) return;

		if (rdKegiatan) rdKegiatan.textContent = item.kegiatanJudul || 'Jejak Rasa';
		if (rdTeks) rdTeks.textContent = item.teks;
		if (rdInisial) rdInisial.textContent = item.inisial;
		if (rdNama) rdNama.textContent = item.nama;
		if (rdDivisi) rdDivisi.textContent = item.divisi || 'Teman Aethra 03';
		if (rdCounter) {
			rdCounter.textContent = `${String(currentMem + 1).padStart(2, '0')} / ${String(memories.length).padStart(2, '0')}`;
		}
	};

	const openMemory = (index: number) => {
		if (!dialog) return;
		renderMemory(index);
		if (!dialog.open) dialog.showModal();
	};

	rdClose?.addEventListener('click', () => dialog?.close());
	rdPrev?.addEventListener('click', () => renderMemory(currentMem - 1));
	rdNext?.addEventListener('click', () => renderMemory(currentMem + 1));

	dialog?.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	dialog?.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') {
			e.preventDefault();
			renderMemory(currentMem - 1);
		} else if (e.key === 'ArrowRight') {
			e.preventDefault();
			renderMemory(currentMem + 1);
		}
	});

	// 3. Favorit (localStorage), Filter, Pencarian & Shuffle
	const loadFavs = (): Set<string> => {
		try {
			const raw = window.localStorage.getItem(FAV_KEY);
			if (!raw) return new Set();
			const parsed = JSON.parse(raw);
			return Array.isArray(parsed) ? new Set(parsed.filter((v): v is string => typeof v === 'string')) : new Set();
		} catch {
			return new Set();
		}
	};

	const saveFavs = (set: Set<string>) => {
		try {
			window.localStorage.setItem(FAV_KEY, JSON.stringify(Array.from(set)));
		} catch {
			// Abaikan jika penyimpanan lokal dinonaktifkan
		}
	};

	const favs = loadFavs();
	const favTotalEl = document.querySelector<HTMLElement>('[data-fav-total]');
	const favFilterCountEl = document.querySelector<HTMLElement>('[data-fav-filter-count]');
	const favBtns = document.querySelectorAll<HTMLButtonElement>('[data-fav-id]');
	const favFilterBtn = document.querySelector<HTMLButtonElement>('[data-rasa-fav-filter]');

	const syncFavUI = () => {
		const count = favs.size;
		if (favTotalEl) favTotalEl.textContent = String(count);
		if (favFilterCountEl) favFilterCountEl.textContent = String(count);

		favBtns.forEach((btn) => {
			const id = btn.dataset.favId ?? '';
			const saved = favs.has(id);
			btn.textContent = saved ? '★' : '☆';
			btn.classList.toggle('is-saved', saved);
			btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
		});
	};

	const grid = document.querySelector<HTMLElement>('[data-rasa-grid]');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-rasa-card]'));
	const openTriggers = document.querySelectorAll<HTMLButtonElement>('[data-open-story]');
	const searchInput = document.querySelector<HTMLInputElement>('[data-rasa-search]');
	const tagBtns = document.querySelectorAll<HTMLButtonElement>('[data-rasa-tag]');
	const shuffleBtn = document.querySelector<HTMLButtonElement>('[data-rasa-shuffle]');
	const resetBtn = document.querySelector<HTMLButtonElement>('[data-rasa-reset]');
	const emptyEl = document.querySelector<HTMLElement>('[data-rasa-empty]');

	let activeTag = 'all';
	let onlyFavs = false;
	let query = '';

	const applyFilters = () => {
		const q = query.trim().toLowerCase();
		let shown = 0;

		cards.forEach((card) => {
			const id = card.dataset.id ?? '';
			const tags = (card.dataset.tags ?? '').split('|');
			const haystack = card.dataset.search ?? '';
			const favPass = !onlyFavs || favs.has(id);
			const tagPass = activeTag === 'all' || tags.includes(activeTag);
			const searchPass = !q || haystack.includes(q);
			const visible = favPass && tagPass && searchPass;

			card.hidden = !visible;
			if (visible) shown += 1;
		});

		if (emptyEl) emptyEl.hidden = shown > 0;
	};

	syncFavUI();

	favBtns.forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const id = btn.dataset.favId;
			if (!id) return;
			if (favs.has(id)) favs.delete(id);
			else favs.add(id);
			saveFavs(favs);
			syncFavUI();
			if (onlyFavs) applyFilters();
		});
	});

	openTriggers.forEach((btn) => {
		btn.addEventListener('click', () => {
			openMemory(Number(btn.dataset.openStory ?? 0));
		});
	});

	searchInput?.addEventListener('input', () => {
		query = searchInput.value;
		applyFilters();
	});

	tagBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			onlyFavs = false;
			favFilterBtn?.classList.remove('is-active');
			activeTag = btn.dataset.rasaTag ?? 'all';
			tagBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
			applyFilters();
		});
	});

	favFilterBtn?.addEventListener('click', () => {
		onlyFavs = !onlyFavs;
		favFilterBtn.classList.toggle('is-active', onlyFavs);
		if (onlyFavs) {
			activeTag = 'all';
			tagBtns.forEach((b) => b.classList.remove('is-active'));
		} else {
			tagBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.rasaTag === 'all'));
		}
		applyFilters();
	});

	shuffleBtn?.addEventListener('click', () => {
		if (!grid) return;
		const current = Array.from(grid.children);
		const state = !reducedMotion ? Flip.getState(current) : null;

		for (let i = current.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[current[i], current[j]] = [current[j]!, current[i]!];
		}
		current.forEach((el) => grid.appendChild(el));

		if (state && !reducedMotion) {
			Flip.from(state, { duration: 0.45, ease: 'power2.inOut', stagger: 0.03 });
		}
	});

	resetBtn?.addEventListener('click', () => {
		query = '';
		activeTag = 'all';
		onlyFavs = false;
		if (searchInput) searchInput.value = '';
		favFilterBtn?.classList.remove('is-active');
		tagBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.rasaTag === 'all'));
		applyFilters();
	});

	initTiltCards('[data-tilt]');

	initMotion((gsapInstance) => {
		gsapInstance.from('.story-card', {
			y: 26,
			opacity: 0,
			duration: 0.55,
			ease: 'power2.out',
			stagger: 0.08,
		});
	});
</script>

<style>
	.page-head {
		padding-top: clamp(3rem, 6vw, 4.5rem);
		padding-bottom: 2.75rem;
		border-bottom: 1px solid var(--border);
	}

	.head-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
		gap: 2.5rem;
		align-items: center;
	}

	.head-copy {
		max-width: 38rem;
	}

	.head-desc {
		font-size: 1.02rem;
		color: var(--ink-muted);
		margin: 0 0 1.5rem;
	}

	.head-stats {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.stat-pill {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.55rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--surface);
	}

	.stat-pill strong {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		color: var(--navy);
		line-height: 1;
	}

	.stat-pill span {
		font-size: 0.76rem;
		font-weight: 500;
		color: var(--ink-faint);
	}

	/* Kartu Pemantik Obrolan */
	.prompt-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.4rem 1.5rem;
		display: grid;
		gap: 1rem;
	}

	.prompt-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}

	.prompt-counter {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--gold);
		font-weight: 600;
	}

	.prompt-tag {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.prompt-text {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.3rem, 2.3vw, 1.65rem);
		color: var(--navy);
		margin: 0;
		line-height: 1.3;
	}

	.prompt-actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.controls-wrap {
		padding-top: 2rem;
		padding-bottom: 1.75rem;
	}

	.controls-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.search-wrap {
		flex: 1 1 18rem;
		max-width: 24rem;
	}

	.filter-group {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.wall {
		padding-bottom: 3rem;
	}

	.rasa-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(295px, 1fr));
		gap: 1.25rem;
	}

	.story-card {
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 1.45rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition:
			border-color 0.22s ease,
			box-shadow 0.22s ease;
	}

	.story-card[data-variant='warm'] {
		background: #fcfaf5;
		border-color: #ebe3d0;
	}

	.story-card[data-variant='navy'] {
		background: var(--navy);
		border-color: var(--navy);
		color: #ffffff;
	}

	.story-card[hidden] {
		display: none;
	}

	.story-card:hover {
		border-color: var(--navy);
		box-shadow: 0 22px 44px -18px rgba(11, 22, 40, 0.14);
	}

	.story-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.75rem;
	}

