---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Moon from '../components/Moon.astro';

const TOTAL = 64;
const peserta = (await getCollection('peserta', ({ data }) => data.setuju)).sort((a, b) =>
	a.data.nama.localeCompare(b.data.nama, 'id'),
);

const inisial = (nama: string) =>
	nama
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((k) => k[0]!.toUpperCase())
		.join('');

// 64 titik: yang sudah ada datanya tampil inisial, sisanya bintang kosong.
const titik = Array.from({ length: TOTAL }, (_, i) => {
	const p = peserta[i];
	return p ? { label: inisial(p.data.nama), nama: p.data.nama } : null;
});

const manifesto =
	'Enam puluh empat orang dari banyak daerah, satu periode yang sama. Di sini kita simpan wajah, cerita, dan momen supaya tidak hilang setelah magang selesai.';

const motto = [
	{ kata: 'Cipta', isi: 'Karya dan dokumentasi yang kita buat bersama.', href: '/cipta', no: '01' },
	{ kata: 'Rasa', isi: 'Kenangan, tawa, dan pesan untuk satu sama lain.', href: '/rasa', no: '02' },
	{ kata: 'Karsa', isi: 'Tekad yang kita bawa pulang setelah semua ini.', href: null, no: '03' },
];
---

<BaseLayout>
	<!-- 1. HERO -->
	<section class="hero" data-hero>
		<div class="hero-inner container">
			<p class="eyebrow" data-rise>Masadagri · Kementerian Dalam Negeri · Batch 3</p>

			<h1 class="hero-title" aria-label="Aethra 03">
				<span class="word-script" data-rise>Aethra</span>
				<span class="word-num" data-rise>03</span>
			</h1>

			<p class="hero-lead" data-rise>
				Dokumentasi angkatan, dibuat oleh peserta untuk peserta.{' '}
				<em>Cipta · Rasa · Karsa.</em>
			</p>

			<div class="hero-cta" data-rise>
				<a class="btn btn-gold" href="/rasi">Lihat 64 wajah</a>
				<a class="btn btn-ghost" href="#cerita">Gulir cerita kami ↓</a>
			</div>
		</div>

		<!-- Kartu melayang miring -->
		<div class="float-layer" aria-hidden="true">
			<div class="float-card fc-1" data-float="-1">
				<span class="fc-kicker">Rasa</span>
				<span class="fc-text">“Hari pertama semua salah masuk ruangan.”</span>
			</div>
			<div class="float-card fc-2" data-float="1.4">
				<span class="fc-kicker">Cipta</span>
				<span class="fc-big">Momen</span>
			</div>
			<div class="float-card fc-3" data-float="-0.8">
				<span class="fc-kicker">Rasi</span>
				<span class="fc-dots">
					{Array.from({ length: 9 }, () => <i />)}
				</span>
			</div>
			<div class="moon-wrap" data-float="0.6"><Moon /></div>
		</div>

		<!-- Stiker segel -->
		<div class="seal" aria-hidden="true">
			<svg viewBox="0 0 200 200" class="seal-ring">
				<defs>
					<path id="seal-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
				</defs>
				<text>
					<textPath href="#seal-path">AETHRA 03 · CIPTA · RASA · KARSA · MASADAGRI ·</textPath>
				</text>
			</svg>
			<span class="seal-num">64<small>peserta</small></span>
		</div>
	</section>

	<!-- 2. MANIFESTO: kata menyala saat di-scroll -->
	<section id="cerita" class="manifesto container" data-manifesto>
		<p class="label">Tentang kami</p>
		<p class="manifesto-text">
			{manifesto.split(' ').map((w) => <span class="mw">{w} </span>)}
		</p>
	</section>

	<!-- 3. MOTTO -->
	<section class="motto container" aria-labelledby="motto-judul">
		<h2 id="motto-judul" class="sr-only">Motto Aethra 03</h2>
		{
			motto.map((m) => (
				<article class="motto-row" data-motto>
					<span class="motto-no">{m.no}</span>
					<h3 class="motto-word">{m.kata}</h3>
					<p class="motto-isi">{m.isi}</p>
					{m.href ? (
						<a class="motto-link" href={m.href} aria-label={`Buka ${m.kata}`}>
							→
						</a>
					) : (
						<span class="motto-link is-soon" title="Segera hadir">
							·
						</span>
					)}
				</article>
			))
		}
	</section>

	<!-- 4. KONSTELASI 64 -->
	<section class="rasi container" data-rasi aria-labelledby="rasi-judul">
		<div class="rasi-head">
			<p class="label">Rasi Aethra</p>
			<h2 id="rasi-judul">Enam puluh empat bintang, satu rasi.</h2>
			<p class="muted">
				Setiap titik adalah satu teman. Foto akan menggantikan inisial begitu dikirim.
			</p>
		</div>
		<ol class="rasi-grid" aria-label={`${peserta.length} dari ${TOTAL} peserta sudah bergabung`}>
			{
				titik.map((t) => (
					<li class:list={['star', { 'is-empty': !t }]} title={t?.nama}>
						{t ? (
							<span>{t.label}</span>
						) : (
							<span class="sr-only">Belum bergabung</span>
						)}
					</li>
				))
			}
		</ol>
		<a class="btn btn-gold rasi-cta" href="/rasi">Kenali semuanya</a>
	</section>

	<!-- 5. BENTO TAUTAN -->
	<section class="bento container" aria-labelledby="bento-judul">
		<h2 id="bento-judul">Jelajahi</h2>
		<div class="bento-grid">
			<a class="tile tile-rasi" href="/rasi" data-tile>
				<span class="tile-no">01</span>
				<span class="tile-title">Rasi Aethra</span>
				<span class="tile-sub">64 wajah, nama, dan pesan.</span>
			</a>
			<a class="tile tile-rasa" href="/rasa" data-tile>
				<span class="tile-no">02</span>
				<span class="tile-title">Rasa</span>
				<span class="tile-sub">Jejak kita: cerita lucu sampai haru.</span>
			</a>
			<a class="tile tile-cipta" href="/cipta" data-tile>
				<span class="tile-no">03</span>
				<span class="tile-title">Cipta</span>
				<span class="tile-sub">Galeri foto dan video per kegiatan.</span>
			</a>
		</div>
	</section>
</BaseLayout>

<script>
	import { initMotion } from '../scripts/motion';

	initMotion((gsap) => {
		// Hero: muncul berurutan
		gsap.from('[data-rise]', {
			y: 40,
			opacity: 0,
			duration: 1,
			ease: 'power3.out',
			stagger: 0.12,
		});
		gsap.from('.float-card, .moon-wrap', {
			y: 80,
			opacity: 0,
			duration: 1.4,
			ease: 'power3.out',
			stagger: 0.15,
			delay: 0.3,
		});
		gsap.from('.seal', { scale: 0.4, opacity: 0, duration: 1, ease: 'back.out(1.7)', delay: 0.9 });

		// Hero: kartu bergerak beda kecepatan saat di-scroll (parallax)
		document.querySelectorAll<HTMLElement>('[data-float]').forEach((el) => {
			const speed = Number(el.dataset.float);
			gsap.to(el, {
				yPercent: -60 * speed,
				ease: 'none',
				scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true },
			});
		});

		// Manifesto: kata menyala satu per satu
		gsap.fromTo(
			'.mw',
			{ opacity: 0.15 },
			{
				opacity: 1,
				ease: 'none',
				stagger: 0.05,
				scrollTrigger: {
					trigger: '[data-manifesto]',
					start: 'top 75%',
					end: 'bottom 45%',
					scrub: true,
				},
			},
		);

		// Motto: baris masuk satu per satu
		gsap.utils.toArray<HTMLElement>('[data-motto]').forEach((row) => {
			gsap.from(row.children, {
				y: 60,
				opacity: 0,
				duration: 0.9,
				ease: 'power3.out',
				stagger: 0.08,
				scrollTrigger: { trigger: row, start: 'top 82%' },
			});
		});

		// Konstelasi: bintang berhamburan lalu berkumpul membentuk kisi 8x8
		const stars = gsap.utils.toArray<HTMLElement>('.star');
		const spread = Math.min(260, window.innerWidth * 0.3);
		gsap.from(stars, {
			x: () => gsap.utils.random(-spread, spread),
			y: () => gsap.utils.random(-spread * 0.8, spread * 0.8),
			scale: () => gsap.utils.random(0.2, 0.7),
			opacity: 0,
			ease: 'power2.out',
			stagger: { each: 0.01, from: 'random' },
			scrollTrigger: { trigger: '[data-rasi]', start: 'top 80%', end: 'center 60%', scrub: 1 },
		});

		// Bento: muncul bergeser dari bawah
		gsap.from('[data-tile]', {
			y: 80,
			opacity: 0,
			duration: 0.9,
			ease: 'power3.out',
			stagger: 0.12,
			scrollTrigger: { trigger: '.bento-grid', start: 'top 85%' },
		});
	});
</script>

<style>
	/* ---------- umum ---------- */
	.label {
		font-size: 0.78rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gold-500);
		margin: 0 0 1rem;
	}
	.muted {
		color: var(--ink-soft);
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.4rem;
		border-radius: 999px;
		font-weight: 500;
		text-decoration: none;
		transition:
			transform 0.25s ease,
			background-color 0.25s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn-gold {
		background: linear-gradient(135deg, var(--gold-300), var(--gold-500));
		color: var(--navy-950);
	}
	.btn-ghost {
		color: var(--ink);
		border: 1px solid color-mix(in srgb, var(--gold-300) 40%, transparent);
	}
	.btn-ghost:hover {
		background: color-mix(in srgb, var(--gold-300) 10%, transparent);
	}

	/* ---------- 1. hero ---------- */
	.hero {
		position: relative;
		min-height: calc(100svh - 60px);
		display: grid;
		align-items: center;
		overflow: hidden;
		isolation: isolate;
	}
	.hero-inner {
		position: relative;
		z-index: 2;
		padding-block: 4rem;
	}
	.eyebrow {
		font-size: 0.78rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gold-500);
		margin: 0 0 1rem;
	}
	.hero-title {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 1.2rem;
		margin: 0;
		line-height: 0.85;
	}
	.word-script {
		font-family: var(--font-script);
		font-size: clamp(5.5rem, 19vw, 15rem);
		background: linear-gradient(180deg, #fff3cc 10%, var(--gold-400) 60%, var(--gold-500));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		/* ruang untuk ekor huruf script agar tidak terpotong oleh background-clip */
		padding: 0.18em 0.25em 0.12em 0.12em;
		margin: -0.18em -0.1em -0.12em -0.12em;
		line-height: 1.05;
		filter: drop-shadow(0 8px 40px rgb(228 191 92 / 0.25));
	}
	.word-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(3rem, 9vw, 7rem);
		color: var(--ink);
	}
	.hero-lead {
		max-width: 32rem;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		color: var(--ink-soft);
		margin: 1.5rem 0 2rem;
	}
	.hero-lead em {
		font-family: var(--font-serif);
		font-size: 1.25em;
		color: var(--gold-300);
	}
	.hero-cta {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.float-layer {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}
	.float-card {
		position: absolute;
		display: grid;
		gap: 0.4rem;
		padding: 1rem 1.1rem;
		border-radius: var(--radius);
		background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
		border: 1px solid rgb(243 217 139 / 0.25);
		backdrop-filter: blur(8px);
		box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
	}
	.fc-kicker {
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gold-400);
	}
	.fc-1 {
		width: 15rem;
		right: 8%;
		top: 14%;
		rotate: 6deg;
	}
	.fc-text {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.25rem;
		line-height: 1.25;
	}
	.fc-2 {
		right: 26%;
		bottom: 14%;
		rotate: -8deg;
	}
	.fc-big {
		font-family: var(--font-script);
		font-size: 3rem;
		color: var(--gold-300);
		line-height: 1;
	}
	.fc-3 {
		right: 4%;
		bottom: 22%;
		rotate: 10deg;
	}
	.fc-dots {
		display: grid;
		grid-template-columns: repeat(3, 1.6rem);
		gap: 0.4rem;
	}
	.fc-dots i {
		width: 1.6rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, var(--gold-300), var(--navy-600));
	}
	.moon-wrap {
		position: absolute;
		right: 14%;
		top: 32%;
		width: clamp(9rem, 18vw, 15rem);
		opacity: 0.9;
		z-index: -1;
	}

	.seal {
		position: absolute;
		z-index: 3;
		left: min(58%, 40rem);
		top: 10%;
		width: 8.5rem;
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: radial-gradient(circle, var(--gold-300), var(--gold-500));
		color: var(--navy-950);
		rotate: -12deg;
		box-shadow: 0 20px 40px -10px rgb(0 0 0 / 0.6);
	}
	.seal-ring {
		position: absolute;
		inset: 0;
		font-size: 13.5px;
		letter-spacing: 0.18em;
		font-weight: 600;
		fill: var(--navy-900);
	}
	@media (prefers-reduced-motion: no-preference) {
		.seal-ring {
			animation: spin 22s linear infinite;
		}
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	.seal-ring {
		transform-origin: 50% 50%;
	}
	.seal-num {
		display: grid;
		text-align: center;
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 600;
		font-size: 2.6rem;
		line-height: 0.9;
	}
	.seal-num small {
		font-family: var(--font-body);
		font-style: normal;
		font-size: 0.65rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
	}

	@media (max-width: 820px) {
		.float-layer {
			opacity: 0.45;
		}
		.fc-1,
		.fc-2,
		.fc-3 {
			display: none;
		}
		.moon-wrap {
			right: -2rem;
			top: 8%;
		}
		.seal {
			left: auto;
			right: 1rem;
			top: auto;
			bottom: 1.5rem;
			width: 6.5rem;
		}
		.seal-ring {
			font-size: 12px;
		}
		.seal-num {
			font-size: 2rem;
		}
	}

	/* ---------- 2. manifesto ---------- */
	.manifesto {
		padding-block: clamp(5rem, 14vw, 10rem);
	}
	.manifesto-text {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(1.9rem, 4.6vw, 3.9rem);
		line-height: 1.15;
		margin: 0;
		max-width: 60rem;
	}

	/* ---------- 3. motto ---------- */
	.motto {
		border-top: 1px solid rgb(243 217 139 / 0.2);
	}
	.motto-row {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 22rem) 3rem;
		align-items: center;
		gap: 1.5rem;
		padding-block: clamp(1.5rem, 4vw, 2.75rem);
		border-bottom: 1px solid rgb(243 217 139 / 0.2);
	}
	.motto-no {
		font-size: 0.85rem;
		color: var(--gold-500);
		letter-spacing: 0.15em;
	}
	.motto-word {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(3.5rem, 12vw, 9rem);
		line-height: 0.9;
		margin: 0;
		color: var(--ink);
		transition: color 0.3s ease;
	}
	.motto-row:hover .motto-word {
		color: var(--gold-300);
	}
	.motto-isi {
		margin: 0;
		color: var(--ink-soft);
	}
	.motto-link {
		justify-self: end;
		display: grid;
		place-items: center;
		width: 3rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid rgb(243 217 139 / 0.4);
		text-decoration: none;
		font-size: 1.2rem;
		transition: transform 0.25s ease;
	}
	.motto-link:not(.is-soon):hover {
		transform: rotate(-45deg);
		background: var(--gold-400);
		color: var(--navy-950);
	}
	.is-soon {
		opacity: 0.4;
	}
	@media (max-width: 720px) {
		.motto-row {
			grid-template-columns: 2rem 1fr 3rem;
		}
		.motto-isi {
			grid-column: 2 / -1;
			grid-row: 2;
		}
	}

	/* ---------- 4. rasi ---------- */
	.rasi {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding-block: clamp(5rem, 12vw, 9rem);
	}
	.rasi-head h2 {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(2.2rem, 5vw, 3.8rem);
		color: var(--ink);
	}
	.rasi-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: clamp(0.35rem, 1.2vw, 0.8rem);
	}
	.star {
		aspect-ratio: 1;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: clamp(0.55rem, 1.2vw, 0.85rem);
		font-weight: 600;
		color: var(--navy-950);
		background: radial-gradient(circle at 35% 30%, #fff3cc, var(--gold-400) 55%, var(--gold-500));
		box-shadow: 0 0 18px rgb(228 191 92 / 0.45);
	}
	.star.is-empty {
		background: radial-gradient(circle, rgb(243 217 139 / 0.35) 0 12%, transparent 14%),
			rgb(255 255 255 / 0.03);
		border: 1px solid rgb(243 217 139 / 0.18);
		box-shadow: none;
	}
	.rasi-cta {
		grid-column: 1;
		justify-self: start;
	}
	@media (max-width: 820px) {
		.rasi {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- 5. bento ---------- */
	.bento {
		padding-bottom: 2rem;
	}
	.bento h2 {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		color: var(--ink);
	}
	.bento-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		grid-template-rows: repeat(2, minmax(13rem, auto));
		gap: 1rem;
	}
	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.35rem;
		padding: 1.6rem;
		border-radius: calc(var(--radius) * 1.5);
		text-decoration: none;
		color: var(--ink);
		overflow: hidden;
		border: 1px solid rgb(243 217 139 / 0.18);
		transition:
			transform 0.35s ease,
			border-color 0.35s ease;
	}
	.tile:hover {
		transform: translateY(-4px);
		border-color: rgb(243 217 139 / 0.55);
	}
	.tile-rasi {
		grid-row: span 2;
		background:
			radial-gradient(circle at 75% 25%, rgb(228 191 92 / 0.35), transparent 45%),
			linear-gradient(160deg, var(--navy-600), var(--navy-900));
	}
	.tile-rasa {
		background: linear-gradient(150deg, #1d2f63, #0d1838);
	}
	.tile-cipta {
		background: linear-gradient(150deg, #2a2a52, #10173a);
	}
	.tile-no {
		position: absolute;
		top: 1.2rem;
		right: 1.4rem;
		color: var(--gold-500);
		font-size: 0.85rem;
		letter-spacing: 0.15em;
