---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Polaroid from '../components/Polaroid.astro';

const TOTAL = 64;
const peserta = (await getCollection('peserta', ({ data }) => data.setuju)).sort((a, b) =>
	a.data.nama.localeCompare(b.data.nama, 'id'),
);

const inisial = (nama: string) =>
	nama
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((k) => k[0]!.toUpperCase())
		.join('');

const kontakSheet = Array.from({ length: TOTAL }, (_, i) => {
	const p = peserta[i];
	const no = String(i + 1).padStart(2, '0');
	if (!p) {
		return {
			no,
			inisial: '',
			nama: `Menunggu Profil Rekan #${no}`,
			meta: 'Slot dokumentasi terbuka untuk anggota Aethra 03',
			tercatat: false,
		};
	}

	const meta = [p.data.divisi, p.data.daerah].filter(Boolean).join(' · ') || 'Anggota Aethra 03';
	return {
		no,
		inisial: inisial(p.data.nama),
		nama: p.data.nama,
		meta,
		tercatat: true,
	};
});

const spotlightAwal = kontakSheet.find((item) => item.tercatat) ?? kontakSheet[0]!;

const manifesto =
	'Enam puluh empat orang dari berbagai daerah, dipersatukan dalam satu masa. Di halaman buku tahunan ini kita simpan wajah, cerita, dan jejak langkah agar tetap hangat diingat setelah masa bakti usai.';

const motto = [
	{
		no: '01',
		bab: 'PILAR PERTAMA',
		kata: 'Cipta',
		isi: 'Karya, dokumentasi kegiatan, dan jejak proyek yang kita bangun bersama.',
		href: '/cipta',
		label: 'Buka Galeri',
	},
	{
		no: '02',
		bab: 'PILAR KEDUA',
		kata: 'Rasa',
		isi: 'Cerita spontan, tawa di sela kesibukan, dan pesan hangat antarteman.',
		href: '/rasa',
		label: 'Baca Cerita',
	},
	{
		no: '03',
		bab: 'PILAR KETIGA',
		kata: 'Karsa',
		isi: 'Semangat belajar dan pengabdian yang kita bawa pulang ke daerah masing-masing.',
		href: null,
		label: 'Segera',
	},
];

const babArsip = [
	{
		id: 'rasi',
		nomor: 'BAGIAN 01',
		halaman: '64 Rekan',
		judul: 'Rasi Aethra',
		sub: 'Direktori 64 Rekan Seperjuangan',
		deskripsi:
			'Wajah, profil singkat, asal daerah, dan pesan kenangan dari setiap anggota Masadagri Batch III.',
		href: '/rasi',
	},
	{
		id: 'rasa',
		nomor: 'BAGIAN 02',
		halaman: 'Cerita & Pesan',
		judul: 'Jejak Rasa',
		sub: 'Catatan & Momen Bermakna',
		deskripsi:
			'Kisah-kisah spontan, kebiasaan lucu saat bertugas, hingga kesan mendalam selama di kementerian.',
		href: '/rasa',
	},
	{
		id: 'cipta',
		nomor: 'BAGIAN 03',
		halaman: 'Foto & Karya',
		judul: 'Galeri Cipta',
		sub: 'Dokumentasi Visual Kegiatan',
		deskripsi:
			'Koleksi foto kegiatan resmi, rapat koordinasi, hingga potret kebersamaan di luar jam dinas.',
		href: '/cipta',
	},
] as const;

const marqueeItems = [
	'Cipta',
	'Rasa',
	'Karsa',
	'Rumah Aethra 03',
	'Enam Puluh Empat Rekan Seperjuangan',
	'Masadagri Batch III',
];
---

<BaseLayout>
	<!-- 1. HERO -->
	<section class="hero" data-hero>
		<div class="container hero-layout">
			<div class="hero-content">
				<p class="eyebrow" data-rise>Buku Tahunan Angkatan · Masadagri Batch III</p>

				<h1 class="hero-title" data-rise>
					<span class="hero-brand-line">
						<span class="hero-script">Aethra</span>
						<span class="hero-num">03</span>
					</span>
					<span class="hero-sub">
						Enam puluh empat rekan, <em>satu masa</em> yang kita jaga bersama.
					</span>
				</h1>

				<p class="hero-lead" data-rise>
					Ruang dokumentasi kebersamaan peserta Masadagri Batch III—tempat kita menyimpan wajah,
					tawa di sela tugas, dan cerita yang tetap tinggal setelah masa bakti usai.
				</p>

				<div class="hero-cta" data-rise>
					<a class="btn btn-primary" href="/rasi">Kenali 64 Rekan →</a>
					<a class="btn btn-secondary" href="#cerita">Baca Cerita Kita ↓</a>
				</div>

				<dl class="hero-metrics" data-rise>
					<div class="metric-item">
						<dt>Rekan Seperjuangan</dt>
						<dd>64</dd>
					</div>
					<div class="metric-item">
						<dt>Pilar: Cipta · Rasa · Karsa</dt>
						<dd>03</dd>
					</div>
					<div class="metric-item">
						<dt>Angkatan Masadagri</dt>
						<dd>Batch III</dd>
					</div>
				</dl>
			</div>

			<!-- Visual Kanan: Susunan Polaroid & Segel Aethra -->
			<div class="hero-visual" aria-hidden="true">
				<div class="polaroid-stack">
					<div class="stack-item item-back" data-float="0.45">
						<Polaroid
							variant="warm"
							caption="Awal Pertemuan"
							subcaption="64 Daerah · Satu Angkatan"
							tag="PROLOG"
							rotation={6}
						/>
					</div>
					<div class="stack-item item-main" data-float="-0.35">
						<Polaroid
							variant="crest"
							caption="Keluarga Besar Aethra 03"
							subcaption="Cipta · Rasa · Karsa"
							tag="EDISI 03"
							rotation={-4}
						/>
					</div>
				</div>

				<div class="aethra-seal" data-stamp>
					<svg viewBox="0 0 160 160" class="seal-svg">
						<defs>
							<path
								id="aethra-seal-path"
								d="M80,80 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"
							></path>
						</defs>
						<circle cx="80" cy="80" r="74" class="seal-ring-outer"></circle>
						<circle cx="80" cy="80" r="46" class="seal-ring-inner"></circle>
						<text class="seal-text">
							<textPath href="#aethra-seal-path">
								AETHRA 03 ✦ CIPTA RASA KARSA ✦ MASADAGRI ✦
							</textPath>
						</text>
					</svg>
					<div class="seal-center">
						<span class="seal-top">ANGKATAN</span>
						<span class="seal-big">64</span>
						<span class="seal-bottom">REKAN</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. PITA TEKS BERJALAN -->
	<div class="marquee-band" aria-hidden="true">
		<div class="marquee-track">
			<ul class="marquee-list">
				{
					marqueeItems.map((item) => (
						<li class="marquee-item">
							<span>{item}</span>
							<span class="marquee-star">✦</span>
						</li>
					))
				}
			</ul>
			<ul class="marquee-list">
				{
					marqueeItems.map((item) => (
						<li class="marquee-item">
							<span>{item}</span>
							<span class="marquee-star">✦</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<!-- 3. MANIFESTO / PROLOG -->
	<section id="cerita" class="manifesto-section" data-manifesto>
		<div class="container manifesto-layout">
			<div class="manifesto-rail">
				<p class="eyebrow">01 — Prolog</p>
				<p class="rail-note">
					Catatan Pembuka
					<br />
					Keluarga Aethra 03
				</p>
			</div>

			<div class="manifesto-content">
				<blockquote class="manifesto-quote">
					<p class="manifesto-body">
						{manifesto.split(' ').map((kata) => <span class="mw">{kata} </span>)}
					</p>
				</blockquote>
				<div class="manifesto-footer">
					<span class="sign-line">— Rekan-Rekan Aethra 03</span>
					<span class="sign-location">Kementerian Dalam Negeri · Jakarta</span>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. TIGA PILAR -->
	<section class="motto-section" aria-labelledby="motto-judul">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">02 — Nilai Angkatan</p>
				<h2 id="motto-judul" class="section-title">
					Tiga Kata yang Merangkum <em>Perjalanan Kita</em>
				</h2>
				<p class="section-desc">
					Nilai yang menjadi pegangan selama masa bakti dan akan terus kita bawa ke depan.
				</p>
			</div>

			<div class="motto-table">
				{
					motto.map((m) => (
						<article class="motto-row" data-motto>
							<div class="motto-meta">
								<span class="motto-bab">{m.bab}</span>
								<span class="motto-no">{m.no}</span>
							</div>
							<div class="motto-main">
								<h3 class="motto-word">{m.kata}</h3>
								<p class="motto-desc">{m.isi}</p>
							</div>
							<div class="motto-action">
								{m.href ? (
									<a class="btn btn-secondary btn-sm" href={m.href}>
										{m.label} →
									</a>
								) : (
									<span class="soon-pill">{m.label} Hadir</span>
								)}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 5. MOSAIK 64 REKAN -->
	<section class="mosaic-section" data-sheet aria-labelledby="mosaic-judul">
		<div class="container">
			<div class="mosaic-head">
				<div>
					<p class="eyebrow">03 — Konstelasi Angkatan</p>
					<h2 id="mosaic-judul" class="section-title">
						Enam Puluh Empat Wajah, <em>Satu Rasi</em>
					</h2>
					<p class="section-desc">
						Setiap petak mewakili satu nama dan satu cerita dari berbagai penjuru Indonesia.
					</p>
				</div>
				<div class="mosaic-status">
					<span class="status-count">{peserta.length} / 64</span>
					<span class="status-label">Profil Terisi</span>
				</div>
			</div>

			<div class="mosaic-frame">
				<div class="mosaic-spotlight" aria-live="polite">
					<div class="spotlight-info">
						<span class="spotlight-no" data-spotlight-no>#{spotlightAwal.no}</span>
						<div class="spotlight-copy">
							<strong class="spotlight-name" data-spotlight-name>{spotlightAwal.nama}</strong>
							<span class="spotlight-meta" data-spotlight-meta>{spotlightAwal.meta}</span>
						</div>
					</div>
					<a class="spotlight-link" href="/rasi">Buka Rasi Aethra →</a>
				</div>

				<div class="mosaic-grid" role="list" aria-label="Kisi 64 rekan Aethra 03">
					{
						kontakSheet.map((item) => (
							<div role="listitem">
								<button
									type="button"
									class:list={[
										'mosaic-tile',
										{ 'is-filled': item.tercatat, 'is-active': item.no === spotlightAwal.no },
									]}
									data-no={item.no}
									data-nama={item.nama}
									data-meta={item.meta}
									aria-label={`Slot ${item.no}: ${item.nama}`}
								>
									<span class="tile-no">{item.no}</span>
									{item.tercatat ? (
										<>
											<span class="tile-initials">{item.inisial}</span>
											<span class="tile-dot" aria-hidden="true" />
										</>
									) : (
										<span class="tile-star" aria-hidden="true">
											✦
										</span>
									)}
								</button>
							</div>
						))
					}
				</div>

				<div class="mosaic-footer">
					<p class="mosaic-hint">
						Sentuh atau klik tiap petak untuk melihat catatan slot. Potret dan profil lengkap
						terhimpun di halaman Rasi Aethra.
					</p>
					<a class="btn btn-primary" href="/rasi">Jelajahi Semua Profil →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. JELAJAHI BUKU TAHUNAN -->
	<section class="index-section" aria-labelledby="index-judul">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">04 — Jelajahi Buku Tahunan</p>
				<h2 id="index-judul" class="section-title">
					Telusuri Setiap <em>Lembar Kenangan</em>
				</h2>
				<p class="section-desc">
					Tiga bagian utama tempat wajah, cerita, dan foto kebersamaan Aethra 03 dirawat.
				</p>
			</div>

			<div class="index-grid">
				{
					babArsip.map((bab) => (
						<a class="index-card" href={bab.href} data-card>
							<div class="card-illus" aria-hidden="true">
								{bab.id === 'rasi' ? (
									<svg viewBox="0 0 180 76" fill="none">
										<rect x="20" y="14" width="14" height="14" rx="3" fill="#0b1628" />
										<rect x="42" y="14" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="64" y="14" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="86" y="14" width="14" height="14" rx="3" fill="#cfa144" />
										<rect x="20" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="42" y="36" width="14" height="14" rx="3" fill="#0b1628" />
										<rect x="64" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="86" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<circle cx="144" cy="36" r="16" stroke="#cbd5e1" stroke-dasharray="3 3" />
										<path
											d="M144 24 Q145 35 156 36 Q145 37 144 48 Q143 37 132 36 Q143 35 144 24 Z"
											fill="#9e731f"
										/>
									</svg>
								) : bab.id === 'rasa' ? (
									<svg viewBox="0 0 180 76" fill="none">
										<rect
											x="22"
											y="14"
											width="136"
											height="48"
											rx="6"
											fill="#ffffff"
											stroke="#cbd5e1"
										/>
										<line x1="36" y1="29" x2="112" y2="29" stroke="#0b1628" stroke-width="1.5" />
										<line x1="36" y1="39" x2="96" y2="39" stroke="#94a3b8" stroke-width="1.5" />
										<line x1="36" y1="49" x2="78" y2="49" stroke="#cbd5e1" stroke-width="1.5" />
										<circle cx="136" cy="38" r="10" fill="#fcf6e8" stroke="#9e731f" />
									</svg>
								) : (
									<svg viewBox="0 0 180 76" fill="none">
										<rect
											x="24"
											y="18"
											width="56"
											height="42"
											rx="4"
											fill="#f1f5f9"
											stroke="#cbd5e1"
											transform="rotate(-5 52 39)"
										/>
										<rect
											x="94"
											y="16"
											width="62"
											height="46"
											rx="4"
											fill="#0b1628"
											transform="rotate(4 125 39)"
										/>
										<circle cx="132" cy="34" r="6" fill="#cfa144" />
									</svg>
								)}
							</div>

							<div class="card-head">
								<span class="card-vol">{bab.nomor}</span>
								<span class="card-page">{bab.halaman}</span>
							</div>

							<div class="card-body">
								<h3 class="card-title">{bab.judul}</h3>
								<p class="card-sub">{bab.sub}</p>
								<p class="card-desc">{bab.deskripsi}</p>
							</div>

							<div class="card-foot">
								<span class="card-link-text">Buka Bagian →</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	import { initMotion } from '../scripts/motion';

	// Interaksi Spotlight Mosaik 64 (berjalan di semua preferensi gerak)
	const spotlightNo = document.querySelector<HTMLElement>('[data-spotlight-no]');
	const spotlightName = document.querySelector<HTMLElement>('[data-spotlight-name]');
	const spotlightMeta = document.querySelector<HTMLElement>('[data-spotlight-meta]');
	const tiles = document.querySelectorAll<HTMLButtonElement>('.mosaic-tile');

	const setSpotlight = (tile: HTMLButtonElement) => {
		const no = tile.dataset.no ?? '';
		const nama = tile.dataset.nama ?? '';
		const meta = tile.dataset.meta ?? '';

		if (spotlightNo) spotlightNo.textContent = `#${no}`;
		if (spotlightName) spotlightName.textContent = nama;
		if (spotlightMeta) spotlightMeta.textContent = meta;

		tiles.forEach((el) => el.classList.toggle('is-active', el === tile));
	};

	tiles.forEach((tile) => {
		tile.addEventListener('mouseenter', () => setSpotlight(tile));
		tile.addEventListener('focus', () => setSpotlight(tile));
		tile.addEventListener('click', () => setSpotlight(tile));
	});

	initMotion((gsap) => {
		gsap.from('[data-rise]', {
			y: 28,
			opacity: 0,
			duration: 0.85,
			ease: 'power3.out',
			stagger: 0.09,
		});

		gsap.from('.stack-item', {
			y: 50,
			opacity: 0,
			duration: 1.1,
			ease: 'power3.out',
			stagger: 0.18,
			delay: 0.25,
		});

		gsap.from('[data-stamp]', {
			scale: 0.6,
			rotation: -24,
			opacity: 0,
			duration: 0.9,
			ease: 'back.out(1.5)',
			delay: 0.55,
		});

		document.querySelectorAll<HTMLElement>('[data-float]').forEach((el) => {
			const speed = Number(el.dataset.float || 0);
			gsap.to(el, {
				yPercent: -24 * speed,
				ease: 'none',
				scrollTrigger: {
					trigger: '[data-hero]',
					start: 'top top',
					end: 'bottom top',
					scrub: true,
				},
			});
		});

		gsap.fromTo(
			'.mw',
			{ color: '#cbd5e1' },
			{
				color: '#0b1628',
				ease: 'none',
				stagger: 0.05,
				scrollTrigger: {
					trigger: '[data-manifesto]',
					start: 'top 78%',
					end: 'bottom 48%',
					scrub: true,
				},
			},
		);

		gsap.utils.toArray<HTMLElement>('[data-motto]').forEach((row) => {
			gsap.from(row.children, {
				y: 24,
				opacity: 0,
				duration: 0.75,
				ease: 'power3.out',
				stagger: 0.07,
				scrollTrigger: { trigger: row, start: 'top 86%' },
			});
		});

		gsap.from('.mosaic-tile', {
			opacity: 0,
			scale: 0.9,
			duration: 0.45,
			ease: 'power2.out',
			stagger: { each: 0.012, from: 'start' },
			scrollTrigger: {
				trigger: '[data-sheet]',
				start: 'top 78%',
			},
		});

		gsap.from('[data-card]', {
			y: 36,
			opacity: 0,
			duration: 0.75,
			ease: 'power3.out',
			stagger: 0.12,
			scrollTrigger: { trigger: '.index-grid', start: 'top 86%' },
		});
	});
</script>

<style>
	/* ========================================================
     1. HERO
     ======================================================== */
	.hero {
		background: var(--bg);
		padding-top: clamp(3rem, 7vw, 5.5rem);
		padding-bottom: clamp(4rem, 8vw, 6.5rem);
		border-bottom: 1px solid var(--border);
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 5vw, 4.5rem);
		align-items: center;
	}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero-title {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin: 0 0 1.25rem;
	}

	.hero-brand-line {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 0.85rem;
		line-height: 0.9;
	}

	.hero-script {
		font-family: var(--font-script);
		font-weight: 400;
		font-size: clamp(3.9rem, 12vw, 8.8rem);
		color: var(--navy);
		line-height: 0.88;
		padding-right: 0.25rem;
	}

	.hero-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 600;
		font-size: clamp(2.2rem, 5.5vw, 4.4rem);
		color: var(--gold);
	}

	.hero-sub {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1.18;
		color: var(--navy);
		max-width: 30rem;
	}

	.hero-lead {
		max-width: 33rem;
		font-size: clamp(1rem, 1.4vw, 1.12rem);
		color: var(--ink-muted);
		line-height: 1.7;
		margin: 0 0 2rem;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		flex-wrap: wrap;
		margin-bottom: 2.75rem;
	}

	.hero-metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding-top: 1.5rem;
