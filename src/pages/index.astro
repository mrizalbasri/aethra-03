</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { Draggable } from 'gsap/Draggable';
	import { initMotion } from '../scripts/motion';
	import { initTiltCards } from '../scripts/interactions';
	import { setupMemberModal, type MemberItem } from '../scripts/memberModal';

	gsap.registerPlugin(Draggable);

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// 1. Meja Polaroid Interaktif (Draggable & Shuffleable)
	const deckCards = Array.from(document.querySelectorAll<HTMLElement>('[data-deck-card]'));
	const counterEl = document.querySelector<HTMLElement>('[data-deck-counter]');
	const shuffleBtn = document.querySelector<HTMLButtonElement>('[data-deck-shuffle]');
	const resetBtn = document.querySelector<HTMLButtonElement>('[data-deck-reset]');

	if (deckCards.length > 0) {
		const order = deckCards.map((_, i) => i);
		const ranks = [
			{ x: 0, y: 0, scale: 1, zIndex: 3 },
			{ x: 24, y: 20, scale: 0.96, zIndex: 2 },
			{ x: -18, y: 38, scale: 0.92, zIndex: 1 },
		];

		const updateCounter = () => {
			if (!counterEl) return;
			const activeNum = String((order[0] ?? 0) + 1).padStart(2, '0');
			const totalNum = String(deckCards.length).padStart(2, '0');
			counterEl.textContent = `${activeNum} / ${totalNum}`;
		};

		const layoutDeck = (animate = true) => {
			order.forEach((cardIdx, rank) => {
				const el = deckCards[cardIdx];
				const pose = ranks[rank] ?? ranks[ranks.length - 1]!;
				if (!el) return;
				el.style.zIndex = String(pose.zIndex);
				if (animate && !reducedMotion) {
					gsap.to(el, {
						x: pose.x,
						y: pose.y,
						scale: pose.scale,
						rotation: 0,
						opacity: 1,
						duration: 0.45,
						ease: 'power3.out',
					});
				} else {
					gsap.set(el, {
						x: pose.x,
						y: pose.y,
						scale: pose.scale,
						rotation: 0,
						opacity: 1,
					});
				}
			});
			updateCounter();
		};

		let shuffling = false;
		const shuffleDeck = () => {
			if (shuffling || order.length < 2) return;
			if (reducedMotion) {
				const first = order.shift()!;
				order.push(first);
				layoutDeck(false);
				if (resetBtn) resetBtn.hidden = true;
				return;
			}
			shuffling = true;
			const frontEl = deckCards[order[0]!];
			if (!frontEl) {
				shuffling = false;
				return;
			}
			gsap.to(frontEl, {
				x: 95,
				rotation: 8,
				opacity: 0.72,
				duration: 0.22,
				ease: 'power2.in',
				onComplete: () => {
					const first = order.shift()!;
					order.push(first);
					layoutDeck(true);
					if (resetBtn) resetBtn.hidden = true;
					shuffling = false;
				},
			});
		};

		layoutDeck(false);

		shuffleBtn?.addEventListener('click', shuffleDeck);
		resetBtn?.addEventListener('click', () => {
			layoutDeck(true);
			resetBtn.hidden = true;
		});

		if (!reducedMotion) {
			Draggable.create(deckCards, {
				bounds: '.hero-desk',
				onPress() {
					(this.target as HTMLElement).style.zIndex = '20';
				},
				onDrag() {
					if (resetBtn) resetBtn.hidden = false;
				},
				onClick() {
					shuffleDeck();
				},
			});
		} else {
			deckCards.forEach((card) => card.addEventListener('click', shuffleDeck));
		}
	}

	// 2. Switcher Tiga Pilar
	const pilarButtons = document.querySelectorAll<HTMLButtonElement>('[data-pilar-btn]');
	const pilarPanels = document.querySelectorAll<HTMLElement>('[data-pilar-panel]');
	let activePilar = '0';

	const setPilar = (idx: string) => {
		if (idx === activePilar) return;
		activePilar = idx;

		pilarButtons.forEach((btn) => {
			const isActive = btn.dataset.pilarBtn === idx;
			btn.classList.toggle('is-active', isActive);
			btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});

		pilarPanels.forEach((panel) => {
			const match = panel.dataset.pilarPanel === idx;
			panel.hidden = !match;
			if (match && !reducedMotion) {
				gsap.fromTo(panel, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' });
			}
		});
	};

	pilarButtons.forEach((btn) => {
		const idx = btn.dataset.pilarBtn ?? '0';
		btn.addEventListener('click', () => setPilar(idx));
		btn.addEventListener('mouseenter', () => setPilar(idx));
		btn.addEventListener('focus', () => setPilar(idx));
	});

	// 3. Mosaik 64 Interaktif + Filter/Search/Wave + Modal Profil
	const membersDataEl = document.getElementById('aethra-members-data');
	const members: MemberItem[] = membersDataEl?.textContent ? JSON.parse(membersDataEl.textContent) : [];
	const modal = setupMemberModal(members);

	const spotlightNo = document.querySelector<HTMLElement>('[data-spotlight-no]');
	const spotlightName = document.querySelector<HTMLElement>('[data-spotlight-name]');
	const spotlightMeta = document.querySelector<HTMLElement>('[data-spotlight-meta]');
	const spotlightOpenBtn = document.querySelector<HTMLButtonElement>('[data-spotlight-open]');
	const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.mosaic-tile'));
	const mosaicFilterBtns = document.querySelectorAll<HTMLButtonElement>('[data-mosaic-filter]');
	const mosaicSearchInput = document.querySelector<HTMLInputElement>('[data-mosaic-search]');
	const waveBtn = document.querySelector<HTMLButtonElement>('[data-mosaic-wave]');

	let currentSpotlightIndex = Math.max(
		0,
		members.findIndex((m) => m.tercatat),
	);
	let activeMosaicFilter = 'all';
	let activeSearch = '';

	const setSpotlight = (tile: HTMLButtonElement) => {
		const idx = Number(tile.dataset.index ?? 0);
		const no = tile.dataset.no ?? '';
		const nama = tile.dataset.nama ?? '';
		const meta = tile.dataset.meta ?? '';

		currentSpotlightIndex = idx;
		if (spotlightNo) spotlightNo.textContent = `#${no}`;
		if (spotlightName) spotlightName.textContent = nama;
		if (spotlightMeta) spotlightMeta.textContent = meta;

		tiles.forEach((el) => el.classList.toggle('is-active', el === tile));
	};

	const applyMosaicFilters = () => {
		const q = activeSearch.trim().toLowerCase();
		tiles.forEach((tile) => {
			const filled = tile.dataset.filled === '1';
			const text = tile.dataset.search ?? '';
			const filterPass = activeMosaicFilter === 'all' || filled;
			const searchPass = !q || text.includes(q);
			const visible = filterPass && searchPass;

			tile.classList.toggle('is-dimmed', !visible);
			tile.classList.toggle('is-match', Boolean(q && visible));
		});
	};

	tiles.forEach((tile) => {
		tile.addEventListener('mouseenter', () => setSpotlight(tile));
		tile.addEventListener('focus', () => setSpotlight(tile));
		tile.addEventListener('click', () => {
			setSpotlight(tile);
			modal.openAt(Number(tile.dataset.index ?? 0));
		});
	});

	spotlightOpenBtn?.addEventListener('click', () => {
		modal.openAt(currentSpotlightIndex);
	});

	mosaicFilterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			activeMosaicFilter = btn.dataset.mosaicFilter ?? 'all';
			mosaicFilterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
			applyMosaicFilters();
		});
	});

	mosaicSearchInput?.addEventListener('input', () => {
		activeSearch = mosaicSearchInput.value;
		applyMosaicFilters();
	});

	waveBtn?.addEventListener('click', () => {
		if (reducedMotion) return;
		gsap.fromTo(
			tiles,
			{ scale: 1 },
			{
				scale: 1.09,
				duration: 0.24,
				yoyo: true,
				repeat: 1,
				ease: 'power2.inOut',
				stagger: { amount: 0.55, grid: [8, 8], from: 'center' },
			},
		);
	});

	// 4. Tilt Cards & Animasi Scroll
	initTiltCards('[data-tilt]');

	initMotion((gsapInstance) => {
		gsapInstance.from('[data-rise]', {
			y: 26,
			opacity: 0,
			duration: 0.85,
			ease: 'power3.out',
			stagger: 0.08,
		});

		gsapInstance.from('.polaroid-deck', {
			y: 36,
			opacity: 0,
			duration: 1,
			ease: 'power3.out',
			delay: 0.2,
		});

		gsapInstance.from('[data-stamp]', {
			scale: 0.6,
			rotation: -24,
			opacity: 0,
			duration: 0.9,
			ease: 'back.out(1.5)',
			delay: 0.45,
		});

		gsapInstance.fromTo(
			'.mw',
			{ color: '#cbd5e1' },
			{
				color: '#0b1628',
				ease: 'none',
				stagger: 0.05,
				scrollTrigger: {
					trigger: '[data-manifesto]',
					start: 'top 78%',
					end: 'bottom 48%',
					scrub: true,
				},
			},
		);

		gsapInstance.fromTo(
			'[data-manifesto-bar]',
			{ scaleX: 0 },
			{
				scaleX: 1,
				ease: 'none',
				scrollTrigger: {
					trigger: '[data-manifesto]',
					start: 'top 78%',
					end: 'bottom 48%',
					scrub: true,
				},
			},
		);

		gsapInstance.from('.mosaic-tile', {
			opacity: 0,
			scale: 0.9,
			duration: 0.45,
			ease: 'power2.out',
			stagger: { each: 0.012, from: 'start' },
			scrollTrigger: {
				trigger: '[data-sheet]',
				start: 'top 78%',
			},
		});

		gsapInstance.from('[data-card]', {
			y: 34,
			opacity: 0,
			duration: 0.75,
			ease: 'power3.out',
			stagger: 0.12,
			scrollTrigger: { trigger: '.index-grid', start: 'top 86%' },
		});
	});
</script>

