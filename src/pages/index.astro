							<div class="card-head">
								<span class="card-vol">{bab.nomor}</span>
								<span class="card-page">{bab.halaman}</span>
							</div>

							<div class="card-body">
								<h3 class="card-title">{bab.judul}</h3>
								<p class="card-sub">{bab.sub}</p>
								<p class="card-desc">{bab.deskripsi}</p>
