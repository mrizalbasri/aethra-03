---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Polaroid from '../components/Polaroid.astro';
import MemberModal from '../components/MemberModal.astro';
import type { MemberItem } from '../scripts/memberModal';

const TOTAL = 64;
const peserta = (await getCollection('peserta', ({ data }) => data.setuju)).sort((a, b) =>
	a.data.nama.localeCompare(b.data.nama, 'id'),
);
const kenangan = await getCollection('kenangan');
const kegiatan = (await getCollection('kegiatan')).sort(
	(a, b) => b.data.tanggal.getTime() - a.data.tanggal.getTime(),
);

const fotoModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/peserta/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
	{ eager: true },
);

const inisial = (nama: string) =>
	nama
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((k) => k[0]!.toUpperCase())
		.join('');

const kontakSheet: MemberItem[] = await Promise.all(
	Array.from({ length: TOTAL }, async (_, i) => {
		const p = peserta[i];
		const no = String(i + 1).padStart(2, '0');
		if (!p) {
			return {
				no,
				inisial: '',
				nama: `Menunggu Profil Rekan #${no}`,
				meta: 'Slot dokumentasi terbuka untuk anggota Aethra 03',
				tercatat: false,
			};
		}

		let fotoUrl: string | undefined;
		if (p.data.foto) {
			const match = Object.entries(fotoModules).find(([path]) => path.endsWith(`/${p.data.foto}`));
			if (match) {
				const optimized = await getImage({ src: match[1].default, width: 480, height: 480 });
				fotoUrl = optimized.src;
			}
		}

		const meta = [p.data.divisi, p.data.daerah].filter(Boolean).join(' · ') || 'Anggota Aethra 03';
		return {
			no,
			inisial: inisial(p.data.nama),
			nama: p.data.nama,
			meta,
			divisi: p.data.divisi,
			daerah: p.data.daerah,
			kalimat: p.data.kalimat,
			pesan: p.data.pesan,
			fotoUrl,
			tercatat: true,
		};
	}),
);

const spotlightAwal = kontakSheet.find((item) => item.tercatat) ?? kontakSheet[0]!;
const serializedMembers = JSON.stringify(kontakSheet).replace(/</g, '\\u003c');

const manifesto =
	'Enam puluh empat orang dari berbagai daerah, dipersatukan dalam satu masa. Di halaman buku tahunan ini kita simpan wajah, cerita, dan jejak langkah agar tetap hangat diingat setelah masa bakti usai.';

const pilars = [
	{
		no: '01',
		bab: 'PILAR PERTAMA',
		kata: 'Cipta',
		ringkas: 'Karya, dokumentasi kegiatan, dan jejak proyek yang kita bangun bersama.',
	},
	{
		no: '02',
		bab: 'PILAR KEDUA',
		kata: 'Rasa',
		ringkas: 'Cerita spontan, tawa di sela kesibukan, dan pesan hangat antarteman.',
	},
	{
		no: '03',
		bab: 'PILAR KETIGA',
		kata: 'Karsa',
		ringkas: 'Semangat belajar dan pengabdian yang kita bawa pulang ke daerah masing-masing.',
	},
];

const contohKegiatan = kegiatan[0];
const contohKenangan = kenangan[0];

const babArsip = [
	{
		id: 'rasi',
		nomor: 'BAGIAN 01',
		halaman: `${peserta.length} / 64 Rekan`,
		judul: 'Rasi Aethra',
		sub: 'Direktori 64 Rekan Seperjuangan',
		deskripsi:
			'Wajah, profil singkat, asal daerah, dan pesan kenangan dari setiap anggota Masadagri Batch III.',
		href: '/rasi',
	},
	{
		id: 'rasa',
		nomor: 'BAGIAN 02',
		halaman: `${kenangan.length} Cerita`,
		judul: 'Jejak Rasa',
		sub: 'Catatan & Momen Bermakna',
		deskripsi:
			'Kisah-kisah spontan, kebiasaan lucu saat bertugas, hingga kesan mendalam selama di kementerian.',
		href: '/rasa',
	},
	{
		id: 'cipta',
		nomor: 'BAGIAN 03',
		halaman: `${kegiatan.length} Agenda`,
		judul: 'Galeri Cipta',
		sub: 'Dokumentasi Visual Kegiatan',
		deskripsi:
			'Koleksi foto kegiatan resmi, rapat koordinasi, hingga potret kebersamaan di luar jam dinas.',
		href: '/cipta',
	},
] as const;

const marqueeItems = [
	'Cipta',
	'Rasa',
	'Karsa',
	'Rumah Aethra 03',
	'Enam Puluh Empat Rekan Seperjuangan',
	'Masadagri Batch III',
];
---

<BaseLayout>
	<!-- 1. HERO -->
	<section class="hero" data-hero>
		<div class="container hero-layout">
			<div class="hero-content">
				<p class="eyebrow" data-rise>Buku Tahunan Angkatan · Masadagri Batch III</p>

				<h1 class="hero-title" data-rise>
					<span class="hero-brand-line">
						<span class="hero-script">Aethra</span>
						<span class="hero-num">03</span>
					</span>
					<span class="hero-sub">
						Enam puluh empat rekan, <em>satu masa</em> yang kita jaga bersama.
					</span>
				</h1>

				<p class="hero-lead" data-rise>
					Ruang dokumentasi kebersamaan peserta Masadagri Batch III—tempat kita menyimpan wajah,
					tawa di sela tugas, dan cerita yang tetap tinggal setelah masa bakti usai.
				</p>

				<div class="hero-cta" data-rise>
					<a class="btn btn-primary" href="/rasi" data-magnetic data-cursor="Jelajahi">
						Kenali 64 Rekan →
					</a>
					<a class="btn btn-secondary" href="#cerita" data-magnetic>
						Baca Cerita Kita ↓
					</a>
				</div>

				<dl class="hero-metrics" data-rise>
					<div class="metric-item">
						<dt>Rekan Seperjuangan</dt>
						<dd>64</dd>
					</div>
					<div class="metric-item">
						<dt>Pilar: Cipta · Rasa · Karsa</dt>
						<dd>03</dd>
					</div>
					<div class="metric-item">
						<dt>Angkatan Masadagri</dt>
						<dd>Batch III</dd>
					</div>
				</dl>
			</div>

			<!-- Visual Kanan: Meja Polaroid Interaktif (Draggable & Shuffleable) -->
			<div class="hero-desk">
				<div class="polaroid-deck">
					<div class="deck-card" data-deck-card data-cursor="Geser">
						<Polaroid
							variant="crest"
							caption="Keluarga Besar Aethra 03"
							subcaption="Cipta · Rasa · Karsa"
							tag="EDISI 03"
							rotation={-4}
						/>
					</div>
					<div class="deck-card" data-deck-card data-cursor="Geser">
						<Polaroid
							variant="warm"
							caption="Awal Pertemuan"
							subcaption="64 Daerah · Satu Angkatan"
							tag="PROLOG"
							rotation={5}
						/>
					</div>
					<div class="deck-card" data-deck-card data-cursor="Geser">
						<Polaroid
							variant="editorial"
							caption="Tawa di Sela Tugas"
							subcaption="Kementerian Dalam Negeri · Jakarta"
							tag="MEMORI"
							rotation={-2}
						/>
					</div>
				</div>

				<div class="aethra-seal" data-stamp aria-hidden="true">
					<svg viewBox="0 0 160 160" class="seal-svg">
						<defs>
							<path
								id="aethra-seal-path"
								d="M80,80 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"
							></path>
						</defs>
						<circle cx="80" cy="80" r="74" class="seal-ring-outer"></circle>
						<circle cx="80" cy="80" r="46" class="seal-ring-inner"></circle>
						<text class="seal-text">
							<textPath href="#aethra-seal-path">
								AETHRA 03 ✦ CIPTA RASA KARSA ✦ MASADAGRI ✦
							</textPath>
						</text>
					</svg>
					<div class="seal-center">
						<span class="seal-top">ANGKATAN</span>
						<span class="seal-big">64</span>
						<span class="seal-bottom">REKAN</span>
					</div>
				</div>

				<div class="deck-controls">
					<span class="deck-counter" data-deck-counter>01 / 03</span>
					<button type="button" class="chip" data-deck-shuffle>Balik Foto ↻</button>
					<button type="button" class="chip" data-deck-reset hidden>Rapikan</button>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. PITA TEKS BERJALAN -->
	<div class="marquee-band" aria-hidden="true">
		<div class="marquee-track">
			<ul class="marquee-list">
				{
					marqueeItems.map((item) => (
						<li class="marquee-item">
							<span>{item}</span>
							<span class="marquee-star">✦</span>
						</li>
					))
				}
			</ul>
			<ul class="marquee-list">
				{
					marqueeItems.map((item) => (
						<li class="marquee-item">
							<span>{item}</span>
							<span class="marquee-star">✦</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<!-- 3. MANIFESTO / PROLOG -->
	<section id="cerita" class="manifesto-section" data-manifesto>
		<div class="container manifesto-layout">
			<div class="manifesto-rail">
				<p class="eyebrow">01 — Prolog</p>
				<p class="rail-note">
					Catatan Pembuka
					<br />
					Keluarga Aethra 03
				</p>
				<div class="rail-meter" aria-hidden="true">
					<span class="rail-meter-bar" data-manifesto-bar></span>
				</div>
			</div>

			<div class="manifesto-content">
				<blockquote class="manifesto-quote">
					<p class="manifesto-body">
						{manifesto.split(' ').map((kata) => <span class="mw">{kata} </span>)}
					</p>
				</blockquote>
				<div class="manifesto-footer">
					<span class="sign-line">— Rekan-Rekan Aethra 03</span>
					<span class="sign-location">Kementerian Dalam Negeri · Jakarta</span>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. TIGA PILAR INTERAKTIF -->
	<section class="motto-section" aria-labelledby="motto-judul">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">02 — Nilai Angkatan</p>
				<h2 id="motto-judul" class="section-title">
					Tiga Kata yang Merangkum <em>Perjalanan Kita</em>
				</h2>
				<p class="section-desc">
					Pilih tiap pilar di kiri untuk melihat cuplikan langsung isi arsip Aethra 03.
				</p>
			</div>

			<div class="pilar-grid">
				<div class="pilar-list" role="tablist" aria-label="Pilar Cipta Rasa Karsa">
					{
						pilars.map((p, idx) => (
							<button
								type="button"
								class:list={['pilar-btn', { 'is-active': idx === 0 }]}
								data-pilar-btn={idx}
								data-cursor="Pilih"
								aria-pressed={idx === 0 ? 'true' : 'false'}
							>
								<div class="pilar-btn-meta">
									<span class="pilar-bab">{p.bab}</span>
									<span class="pilar-no">{p.no}</span>
								</div>
								<div class="pilar-btn-body">
									<span class="pilar-word">{p.kata}</span>
									<span class="pilar-summary">{p.ringkas}</span>
								</div>
								<span class="pilar-arrow" aria-hidden="true">
									→
								</span>
							</button>
						))
					}
				</div>

				<div class="pilar-stage">
					<!-- Panel 0: Cipta -->
					<div class="pilar-panel" data-pilar-panel="0">
						<div class="panel-top">
							<span class="panel-badge">01 · CIPTA</span>
							<span class="panel-stat">{kegiatan.length} Agenda Kegiatan</span>
						</div>
						<div class="panel-visual" aria-hidden="true">
							<svg viewBox="0 0 280 120" fill="none">
								<rect
									x="22"
									y="20"
									width="104"
									height="78"
									rx="6"
									fill="#f1f5f9"
									stroke="#cbd5e1"
									transform="rotate(-4 74 59)"
								></rect>
								<rect
									x="136"
									y="18"
									width="120"
									height="84"
									rx="6"
									fill="#0b1628"
									transform="rotate(3 196 60)"
								></rect>
								<circle cx="176" cy="46" r="10" fill="#cfa144"></circle>
								<path
									d="M148 86 L176 58 L198 78 L216 64 L242 86"
									stroke="#ffffff"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</div>
						<h3 class="panel-title">Karya & Dokumentasi Visual</h3>
						<p class="panel-desc">
							{
								contohKegiatan
									? `Terbaru di arsip: "${contohKegiatan.data.judul}" — ${contohKegiatan.data.deskripsi ?? 'Dokumentasi kegiatan angkatan.'}`
									: 'Rekam jejak foto dan video kegiatan bersama selama masa bakti.'
							}
						</p>
						<a class="btn btn-primary btn-sm" href="/cipta">Buka Galeri Cipta →</a>
					</div>

					<!-- Panel 1: Rasa -->
					<div class="pilar-panel" data-pilar-panel="1" hidden>
						<div class="panel-top">
							<span class="panel-badge">02 · RASA</span>
							<span class="panel-stat">{kenangan.length} Catatan Kenangan</span>
						</div>
						<div class="panel-quote-box">
							<p class="panel-quote">
								“{contohKenangan?.data.teks ?? 'Cerita kecil yang membuat masa magang tak terlupakan.'}”
							</p>
							<span class="panel-quote-author">
								— {contohKenangan?.data.nama ?? 'Rekan Aethra 03'}
							</span>
						</div>
						<h3 class="panel-title">Cerita & Pesan Antarteman</h3>
						<p class="panel-desc">
							Kumpulan kisah spontan, tawa di sela pekerjaan, dan pesan hangat dari rekan-rekan
							Aethra 03.
						</p>
						<a class="btn btn-primary btn-sm" href="/rasa">Baca Jejak Rasa →</a>
					</div>

					<!-- Panel 2: Karsa -->
					<div class="pilar-panel" data-pilar-panel="2" hidden>
						<div class="panel-top">
							<span class="panel-badge">03 · KARSA</span>
							<span class="panel-stat">64 Titik Nusantara</span>
						</div>
						<div class="panel-crest-box" aria-hidden="true">
							<span class="crest-star">✦</span>
							<p class="crest-line">
								Membawa pulang ilmu, jejaring, dan semangat pengabdian ke 64 titik Nusantara.
							</p>
						</div>
						<h3 class="panel-title">Tekad & Kebersamaan Angkatan</h3>
						<p class="panel-desc">
							Setiap rekan pulang ke daerah masing-masing dengan cerita dan ikatan yang tetap
							terhubung di sini.
						</p>
						<a class="btn btn-primary btn-sm" href="/rasi">Kenali 64 Rekan →</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. MOSAIK 64 REKAN INTERAKTIF -->
	<section class="mosaic-section" data-sheet aria-labelledby="mosaic-judul">
		<div class="container">
			<div class="mosaic-head">
				<div>
					<p class="eyebrow">03 — Konstelasi Angkatan</p>
					<h2 id="mosaic-judul" class="section-title">
						Enam Puluh Empat Wajah, <em>Satu Rasi</em>
					</h2>
					<p class="section-desc">
						Cari, saring, atau klik petak mana saja untuk membuka kartu profil anggota Aethra 03.
					</p>
				</div>
				<div class="mosaic-status">
					<span class="status-count">{peserta.length} / 64</span>
					<span class="status-label">Profil Terisi</span>
				</div>
			</div>

			<div class="mosaic-frame">
				<div class="mosaic-toolbar">
					<div class="mosaic-filters">
						<button type="button" class="chip is-active" data-mosaic-filter="all">
							Semua (64)
						</button>
						<button type="button" class="chip" data-mosaic-filter="filled">
							Terisi ({peserta.length})
						</button>
						<button type="button" class="chip" data-mosaic-wave data-cursor="Mainkan">
							Gelombang ✦
						</button>
					</div>
					<div class="mosaic-search-wrap">
						<label class="sr-only" for="mosaic-search">Cari rekan di mosaik 64</label>
						<input
							id="mosaic-search"
							type="search"
							class="search-field"
							placeholder="Cari nama atau daerah..."
							data-mosaic-search
						/>
					</div>
				</div>

				<div class="mosaic-spotlight" aria-live="polite">
					<div class="spotlight-info">
						<span class="spotlight-no" data-spotlight-no>#{spotlightAwal.no}</span>
						<div class="spotlight-copy">
							<strong class="spotlight-name" data-spotlight-name>{spotlightAwal.nama}</strong>
							<span class="spotlight-meta" data-spotlight-meta>{spotlightAwal.meta}</span>
						</div>
					</div>
					<div class="spotlight-actions">
						<button type="button" class="chip" data-spotlight-open>Buka Kartu →</button>
						<a class="spotlight-link" href="/rasi">Direktori Penuh</a>
					</div>
				</div>

				<div class="mosaic-grid" role="list" aria-label="Kisi 64 rekan Aethra 03">
					{
						kontakSheet.map((item, idx) => (
							<div role="listitem">
								<button
									type="button"
									class:list={[
										'mosaic-tile',
										{ 'is-filled': item.tercatat, 'is-active': item.no === spotlightAwal.no },
									]}
									data-index={idx}
									data-no={item.no}
									data-nama={item.nama}
									data-meta={item.meta}
									data-filled={item.tercatat ? '1' : '0'}
									data-search={`${item.nama} ${item.meta} ${item.kalimat ?? ''}`.toLowerCase()}
									data-cursor="Lihat"
									aria-label={`Slot ${item.no}: ${item.nama}`}
								>
									<span class="tile-no">{item.no}</span>
									{item.tercatat ? (
										<>
											<span class="tile-initials">{item.inisial}</span>
											<span class="tile-dot" aria-hidden="true" />
										</>
									) : (
										<span class="tile-star" aria-hidden="true">
											✦
										</span>
									)}
								</button>
							</div>
						))
					}
				</div>

				<div class="mosaic-footer">
					<p class="mosaic-hint">
						Arahkan atau ketuk petak untuk pratinjau cepat; klik petak untuk membuka kartu profil
						lengkap.
					</p>
					<a class="btn btn-primary" href="/rasi" data-magnetic>Jelajahi Semua Profil →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. JELAJAHI BUKU TAHUNAN -->
	<section class="index-section" aria-labelledby="index-judul">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">04 — Jelajahi Buku Tahunan</p>
				<h2 id="index-judul" class="section-title">
					Telusuri Setiap <em>Lembar Kenangan</em>
				</h2>
				<p class="section-desc">
					Tiga bagian utama tempat wajah, cerita, dan foto kebersamaan Aethra 03 dirawat.
				</p>
			</div>

			<div class="index-grid">
				{
					babArsip.map((bab) => (
						<a class="index-card" href={bab.href} data-card data-tilt data-cursor="Buka">
							<div class="card-illus" aria-hidden="true">
								{bab.id === 'rasi' ? (
									<svg viewBox="0 0 180 76" fill="none">
										<rect x="20" y="14" width="14" height="14" rx="3" fill="#0b1628" />
										<rect x="42" y="14" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="64" y="14" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="86" y="14" width="14" height="14" rx="3" fill="#cfa144" />
										<rect x="20" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="42" y="36" width="14" height="14" rx="3" fill="#0b1628" />
										<rect x="64" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<rect x="86" y="36" width="14" height="14" rx="3" fill="#e2e8f0" />
										<circle cx="144" cy="36" r="16" stroke="#cbd5e1" stroke-dasharray="3 3" />
										<path
											d="M144 24 Q145 35 156 36 Q145 37 144 48 Q143 37 132 36 Q143 35 144 24 Z"
											fill="#9e731f"
										/>
									</svg>
								) : bab.id === 'rasa' ? (
									<svg viewBox="0 0 180 76" fill="none">
										<rect
											x="22"
											y="14"
											width="136"
											height="48"
											rx="6"
											fill="#ffffff"
											stroke="#cbd5e1"
										/>
										<line x1="36" y1="29" x2="112" y2="29" stroke="#0b1628" stroke-width="1.5" />
										<line x1="36" y1="39" x2="96" y2="39" stroke="#94a3b8" stroke-width="1.5" />
										<line x1="36" y1="49" x2="78" y2="49" stroke="#cbd5e1" stroke-width="1.5" />
										<circle cx="136" cy="38" r="10" fill="#fcf6e8" stroke="#9e731f" />
									</svg>
								) : (
									<svg viewBox="0 0 180 76" fill="none">
										<rect
											x="24"
											y="18"
											width="56"
											height="42"
											rx="4"
											fill="#f1f5f9"
											stroke="#cbd5e1"
											transform="rotate(-5 52 39)"
										/>
										<rect
											x="94"
											y="16"
											width="62"
											height="46"
											rx="4"
											fill="#0b1628"
											transform="rotate(4 125 39)"
										/>
										<circle cx="132" cy="34" r="6" fill="#cfa144" />
