---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Polaroid from '../components/Polaroid.astro';

const TOTAL = 64;
const peserta = (await getCollection('peserta', ({ data }) => data.setuju)).sort((a, b) =>
	a.data.nama.localeCompare(b.data.nama, 'id'),
);

const inisial = (nama: string) =>
	nama
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((k) => k[0]!.toUpperCase())
		.join('');

// 64 kotak lembar kontak foto
const kontakSheet = Array.from({ length: TOTAL }, (_, i) => {
	const p = peserta[i];
	const no = String(i + 1).padStart(2, '0');
	return p
		? { no, inisial: inisial(p.data.nama), nama: p.data.nama, status: 'tercatat' }
		: { no, inisial: '', nama: `Peserta ${no}`, status: 'kosong' };
});

const manifesto =
	'Enam puluh empat orang dari berbagai daerah, dipersatukan dalam satu masa. Di lembar arsip ini kita simpan wajah, cerita, dan jejak langkah agar tak lekang oleh waktu setelah masa magang usai.';

const motto = [
	{
		no: '01',
		bab: 'BAB I',
		kata: 'Cipta',
		isi: 'Karya, laporan, dan dokumentasi visual yang kita bangun bersama.',
		href: '/cipta',
		label: 'Buka Galeri',
	},
	{
		no: '02',
		bab: 'BAB II',
		kata: 'Rasa',
		isi: 'Kenangan hangat, tawa di sela rapat, dan pesan untuk satu sama lain.',
		href: '/rasa',
		label: 'Baca Cerita',
	},
	{
		no: '03',
		bab: 'BAB III',
		kata: 'Karsa',
		isi: 'Tekad, integritas, dan semangat pengabdian yang kita bawa pulang ke daerah.',
		href: null,
		label: 'Segera',
	},
];

const babArsip = [
	{
		nomor: 'VOL. I',
		halaman: 'Hal. 01–64',
		judul: 'Rasi Aethra',
		sub: 'Direktori 64 Rekan Seperjuangan',
		deskripsi:
			'Wajah, profil, asal daerah, dan pesan kenangan dari setiap rekan Masadagri Batch III.',
		href: '/rasi',
		tag: 'DIREKTORI',
	},
	{
		nomor: 'VOL. II',
		halaman: 'Hal. 65–120',
		judul: 'Jejak Rasa',
		sub: 'Catatan & Momen Bermakna',
		deskripsi:
			'Kisah-kisah spontan, kebiasaan lucu saat bekerja, hingga kesan mendalam selama di kementerian.',
		href: '/rasa',
		tag: 'MEMORI',
	},
	{
		nomor: 'VOL. III',
		halaman: 'Hal. 121–180',
		judul: 'Galeri Cipta',
		sub: 'Dokumentasi Visual Kegiatan',
		deskripsi:
			'Koleksi foto kegiatan resmi, rapat koordinasi, hingga potret kebersamaan di luar jam dinas.',
		href: '/cipta',
		tag: 'GALERI',
	},
];
---

<BaseLayout>
	<!-- 1. HERO ARSIP -->
	<section class="hero" data-hero>
		<div class="container hero-layout">
			<div class="hero-content">
				<p class="archival-tag" data-rise>
					DOKUMEN RESMI ANGKATAN · NO. REG: 03/MASADAGRI/2024
				</p>

				<h1 class="hero-title">
					<span class="hero-script" data-rise>Aethra</span>
					<span class="hero-num" data-rise>03</span>
				</h1>

				<p class="hero-motto-line" data-rise>
					<em>Cipta · Rasa · Karsa</em>
				</p>

				<p class="hero-lead" data-rise>
					Buku tahunan dan arsip digital kebersamaan 64 rekan seperjuangan Masadagri Batch III,
					Kementerian Dalam Negeri Republik Indonesia.
				</p>

				<div class="hero-cta" data-rise>
					<a class="btn btn-primary" href="/rasi">Lihat 64 Rekan Angkatan →</a>
					<a class="btn btn-secondary" href="#cerita">Buka Lembar Cerita ↓</a>
				</div>

				<div class="hero-meta-strip" data-rise>
					<span class="meta-item"><strong>Batch:</strong> III (2024)</span>
					<span class="meta-sep">/</span>
					<span class="meta-item"><strong>Keluarga:</strong> 64 Peserta</span>
					<span class="meta-sep">/</span>
					<span class="meta-item"><strong>Penerbitan:</strong> Inisiatif Angkatan</span>
				</div>
			</div>

			<!-- Visual Tumpukan Polaroid & Stempel Fisik -->
			<div class="hero-visual" aria-hidden="true">
				<div class="polaroid-stack">
					<div class="stack-item item-1" data-float="-0.5">
						<Polaroid
							caption="Hari Pertama Masuk"
							subcaption="Gedung B Kemendagri · Jakarta"
							rotation={-5}
							tag="MEMORI 01"
						/>
					</div>
					<div class="stack-item item-2" data-float="0.6">
						<Polaroid
							caption="Tawa di Sela Tugas"
							subcaption="Masadagri Batch III · 2024"
							rotation={4}
							tag="MEMORI 02"
						/>
					</div>
				</div>

				<!-- Stempel Cap Pos / Arsip Fisik -->
				<div class="rubber-stamp" data-stamp>
					<svg viewBox="0 0 160 160" class="stamp-svg">
						<circle cx="80" cy="80" r="74" class="stamp-circle-outer"></circle>
						<circle cx="80" cy="80" r="68" class="stamp-circle-inner"></circle>
						<defs>
							<path
								id="stamp-path-text"
								d="M80,80 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"
							></path>
						</defs>
						<text class="stamp-text">
							<textPath href="#stamp-path-text">
								* AETHRA 03 * CIPTA RASA KARSA * MASADAGRI *
							</textPath>
						</text>
					</svg>
					<div class="stamp-center">
						<span class="sc-top">ARSIP</span>
						<span class="sc-big">64</span>
						<span class="sc-bottom">REKAN</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. MANIFESTO ANGKATAN -->
	<section id="cerita" class="manifesto-section" data-manifesto>
		<div class="container">
			<div class="manifesto-card">
				<div class="manifesto-header">
					<p class="archival-tag">MANIFESTO ANGKATAN</p>
					<span class="doc-code">REF: MNF-03-2024</span>
				</div>
				<blockquote class="manifesto-quote">
					<p class="manifesto-body">
						{manifesto.split(' ').map((kata) => <span class="mw">{kata} </span>)}
					</p>
				</blockquote>
				<div class="manifesto-footer">
					<span class="sign-line">— Keluarga Besar Aethra 03</span>
					<span class="sign-location">Jakarta Pusat</span>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. TIGA PILAR (MOTTO) -->
	<section class="motto-section" aria-labelledby="motto-judul">
		<div class="container">
			<div class="section-title-wrap">
				<p class="archival-tag">NILAI & PRINSIP</p>
				<h2 id="motto-judul" class="section-title">Tiga Pilar Angkatan</h2>
				<p class="section-desc">
					Nilai yang menjadi pedoman selama masa pengabdian dan akan terus kita rawat di masa
					depan.
				</p>
			</div>

			<div class="motto-table">
				{
					motto.map((m) => (
						<article class="motto-row" data-motto>
							<div class="motto-meta">
								<span class="motto-bab">{m.bab}</span>
								<span class="motto-no">{m.no}</span>
							</div>
							<div class="motto-main">
								<h3 class="motto-word">{m.kata}</h3>
								<p class="motto-desc">{m.isi}</p>
							</div>
							<div class="motto-action">
								{m.href ? (
									<a class="btn btn-secondary btn-sm" href={m.href}>
										{m.label} →
									</a>
								) : (
									<span class="soon-badge">Segera Hadir</span>
								)}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 4. LEMBAR KONTAK 64 REKAN (FOTO CONTACT SHEET) -->
	<section class="sheet-section" data-sheet aria-labelledby="sheet-judul">
		<div class="container">
			<div class="sheet-header">
				<div>
					<p class="archival-tag">LEMBAR KONTAK DOKUMENTASI</p>
					<h2 id="sheet-judul" class="section-title">Enam Puluh Empat Jiwa, Satu Angkatan</h2>
					<p class="section-desc">
						Setiap petak adalah satu nama, satu cerita, dan satu kawan seperjuangan dari berbagai
						penjuru Nusantara.
					</p>
				</div>
				<div class="sheet-badge">
					<span class="badge-num">{peserta.length} / 64</span>
					<span class="badge-text">DATA TERCATAT</span>
				</div>
			</div>

			<div class="contact-sheet-container">
				<div class="contact-sheet-topbar">
					<span>KODAK PROOF SHEET · 64 POSITIONS</span>
					<span>EXP. 2024 · MASADAGRI BATCH III</span>
				</div>

				<ol class="contact-grid" aria-label="Kisi 64 rekan Aethra 03">
					{
						kontakSheet.map((item) => (
							<li
								class:list={['contact-frame', { 'is-filled': item.status === 'tercatat' }]}
								title={item.nama}
							>
								<span class="frame-no">{item.no}</span>
								{item.status === 'tercatat' ? (
									<div class="frame-content">
										<span class="frame-initials">{item.inisial}</span>
										<span class="frame-name">{item.nama}</span>
									</div>
								) : (
									<div class="frame-empty">
										<span class="frame-empty-plus">+</span>
										<span class="frame-empty-sub">Arsip</span>
									</div>
								)}
							</li>
						))
					}
				</ol>

				<div class="contact-sheet-footer">
					<p class="contact-hint">
						Inisial dan nama akan digantikan foto potret resmi saat direktori lengkap dibuka.
					</p>
					<a class="btn btn-primary" href="/rasi">Buka Direktori Lengkap Rasi Aethra →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. INDEKS BUKU TAHUNAN (JELAJAHI) -->
	<section class="index-section" aria-labelledby="index-judul">
		<div class="container">
			<div class="section-title-wrap">
				<p class="archival-tag">INDEKS ARSIP BUKU TAHUNAN</p>
				<h2 id="index-judul" class="section-title">Daftar Isi Dokumentasi</h2>
				<p class="section-desc">
					Telusuri setiap lembaran kenangan yang telah dirangkum dalam volume arsip Aethra 03.
				</p>
			</div>

			<div class="index-grid">
				{
					babArsip.map((bab) => (
						<a class="index-card" href={bab.href} data-card>
							<div class="card-head">
								<span class="card-vol">{bab.nomor}</span>
								<span class="card-page">{bab.halaman}</span>
							</div>
							<div class="card-body">
								<span class="card-tag">{bab.tag}</span>
								<h3 class="card-title">{bab.judul}</h3>
								<h4 class="card-sub">{bab.sub}</h4>
								<p class="card-desc">{bab.deskripsi}</p>
							</div>
							<div class="card-foot">
								<span class="card-link-text">Buka Lembar Bab →</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	import { initMotion } from '../scripts/motion';

	initMotion((gsap) => {
		// 1. Animasi Hero Muncul
		gsap.from('[data-rise]', {
			y: 35,
			opacity: 0,
			duration: 0.9,
			ease: 'power3.out',
			stagger: 0.1,
		});

		// Animasi Polaroid Stack Masuk
		gsap.from('.stack-item', {
			y: 60,
			opacity: 0,
			duration: 1.2,
			ease: 'power3.out',
			stagger: 0.2,
			delay: 0.3,
		});

		// Animasi Stempel Berputar Sedikit Masuk
		gsap.from('[data-stamp]', {
			scale: 0.5,
			rotation: -30,
			opacity: 0,
			duration: 1,
			ease: 'back.out(1.5)',
			delay: 0.7,
		});

		// Parallax Halus Polaroid saat Scroll
		document.querySelectorAll<HTMLElement>('[data-float]').forEach((el) => {
			const speed = Number(el.dataset.float || 0);
			gsap.to(el, {
				yPercent: -25 * speed,
				ease: 'none',
				scrollTrigger: {
					trigger: '[data-hero]',
					start: 'top top',
					end: 'bottom top',
					scrub: true,
				},
			});
		});

		// 2. Manifesto: Kata menyala dari abu-abu samar ke tinta navy penuh
		gsap.fromTo(
			'.mw',
			{ color: '#cbd4e0' },
			{
				color: '#0a1424',
				ease: 'none',
				stagger: 0.05,
				scrollTrigger: {
					trigger: '[data-manifesto]',
					start: 'top 75%',
					end: 'bottom 45%',
					scrub: true,
				},
			},
		);

		// 3. Motto Baris: Masuk berurutan
		gsap.utils.toArray<HTMLElement>('[data-motto]').forEach((row) => {
			gsap.from(row.children, {
				y: 30,
				opacity: 0,
				duration: 0.8,
				ease: 'power3.out',
				stagger: 0.08,
				scrollTrigger: { trigger: row, start: 'top 85%' },
			});
		});

		// 4. Lembar Kontak 64: Efek muncul rapi
		gsap.from('.contact-frame', {
			opacity: 0,
			scale: 0.9,
			duration: 0.5,
			ease: 'power2.out',
			stagger: { each: 0.015, from: 'start' },
			scrollTrigger: {
				trigger: '[data-sheet]',
				start: 'top 75%',
			},
		});

		// 5. Indeks Arsip Kartu Masuk
		gsap.from('[data-card]', {
			y: 50,
			opacity: 0,
			duration: 0.8,
			ease: 'power3.out',
			stagger: 0.15,
			scrollTrigger: { trigger: '.index-grid', start: 'top 85%' },
		});
	});
</script>

<style>
	/* ========================================================
     1. HERO ARSIP
     ======================================================== */
	.hero {
		position: relative;
		padding-top: clamp(3rem, 7vw, 5.5rem);
		padding-bottom: clamp(4rem, 8vw, 6.5rem);
		border-bottom: 1px solid var(--paper-border);
		background-image:
			linear-gradient(to right, rgba(228, 220, 206, 0.3) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(228, 220, 206, 0.3) 1px, transparent 1px);
		background-size: 40px 40px;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero-title {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin: 0.2rem 0 0.8rem;
		line-height: 0.9;
	}

	.hero-script {
		font-family: var(--font-script);
		font-size: clamp(4.8rem, 14vw, 10.5rem);
		color: var(--navy-deep);
		line-height: 0.88;
		padding-right: 0.3rem;
	}

	.hero-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 600;
		font-size: clamp(2.5rem, 6.5vw, 5.5rem);
		color: var(--gold-accent);
	}

	.hero-motto-line {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		color: var(--navy-soft);
		margin: 0 0 1.2rem;
	}

	.hero-lead {
		max-width: 34rem;
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		color: var(--ink-muted);
		line-height: 1.65;
		margin-bottom: 2rem;
	}

	.hero-cta {
		display: flex;
		gap: 0.85rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.hero-meta-strip {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
		padding-top: 1.2rem;
		border-top: 1px dashed var(--paper-border-strong);
		flex-wrap: wrap;
	}

	.hero-meta-strip strong {
		color: var(--navy-soft);
	}

	.meta-sep {
		color: var(--paper-border-strong);
	}

	/* Bagian Visual Kanan: Polaroid Stack & Rubber Stamp */
	.hero-visual {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 26rem;
	}

	.polaroid-stack {
		position: relative;
		width: 100%;
		max-width: 24rem;
		height: 24rem;
	}

	.stack-item {
		position: absolute;
		transition: transform 0.3s ease;
	}

	.item-1 {
		top: 1rem;
		left: 0;
		z-index: 2;
	}

	.item-2 {
		top: 5rem;
		right: 0.5rem;
		z-index: 1;
	}

	.stack-item:hover {
		z-index: 10;
	}

	/* Stempel Karet Fisik (Rubber Stamp) */
	.rubber-stamp {
		position: absolute;
		bottom: -1rem;
		left: -1rem;
		z-index: 5;
		width: 8.5rem;
		height: 8.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--navy-soft);
		opacity: 0.85;
		transform: rotate(-14deg);
		pointer-events: none;
	}

	.stamp-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.stamp-circle-outer {
		fill: none;
		stroke: var(--navy-soft);
		stroke-width: 2.5;
		stroke-dasharray: 4 2;
	}

	.stamp-circle-inner {
		fill: none;
		stroke: var(--navy-soft);
		stroke-width: 1.5;
	}

	.stamp-text {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.16em;
		font-weight: 700;
		fill: var(--navy-soft);
	}

	.stamp-center {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		line-height: 1;
		font-family: var(--font-serif);
	}

	.sc-top,
	.sc-bottom {
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: 0.2em;
		font-weight: 700;
	}

	.sc-big {
		font-size: 2.2rem;
		font-weight: 700;
		font-style: italic;
		color: var(--navy-deep);
		margin-block: 0.1rem;
	}

	/* ========================================================
     2. MANIFESTO ANGKATAN
     ======================================================== */
	.manifesto-section {
		padding-block: clamp(4.5rem, 10vw, 7.5rem);
		background-color: var(--paper-warm);
		border-bottom: 1px solid var(--paper-border);
	}

	.manifesto-card {
		background: #ffffff;
		border: 1px solid var(--paper-border-strong);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 4rem);
		border-radius: var(--radius);
		box-shadow: 0 10px 30px -10px rgba(10, 20, 36, 0.08);
		position: relative;
	}

	.manifesto-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--paper-border);
		padding-bottom: 1.2rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.doc-code {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
		letter-spacing: 0.1em;
	}

	.manifesto-quote {
		margin: 0;
		padding: 0;
	}

	.manifesto-body {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(1.8rem, 3.8vw, 2.9rem);
		line-height: 1.35;
		margin: 0;
		color: var(--navy-deep);
	}

	.mw {
		display: inline;
		transition: color 0.15s ease;
	}

	.manifesto-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--paper-border);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink-muted);
	}

	.sign-line {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--navy-deep);
	}

	/* ========================================================
     3. TIGA PILAR (MOTTO)
     ======================================================== */
	.motto-section {
		padding-block: clamp(4.5rem, 9vw, 7rem);
		border-bottom: 1px solid var(--paper-border);
	}

	.section-title-wrap {
		margin-bottom: 3rem;
	}

	.section-title {
