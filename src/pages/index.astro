---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="hero container">
		<p class="eyebrow">Masadagri · Batch 3</p>
		<h1>Aethra 03</h1>
		<p class="lead">Cipta · Rasa · Karsa</p>
	</section>
</BaseLayout>

<style>
	.hero {
		min-height: 70vh;
		display: grid;
		place-content: center;
		text-align: center;
	}

	.eyebrow {
		letter-spacing: 0.25em;
		text-transform: uppercase;
		font-size: 0.8rem;
		color: var(--gold-500);
		margin: 0;
	}

	.lead {
		color: var(--ink-soft);
		font-size: 1.15rem;
		letter-spacing: 0.15em;
		margin: 0;
	}
</style>
